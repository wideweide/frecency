#!/bin/bash
# ============================================================================
# frecency - navigation/history entry manager with time decay (SQLite + fzf)
# ============================================================================
# Features:
#   - Unified plus type-specific directory/file history in one SQLite database
#   - Multiple topics: dir / file / cmd / any custom topic, each with its own DB
#   - True frecency: event clock + exponential moving sum (EMS); decay on write,
#     alignment on read
#   - Keywords (bookmarks): fast lookup and highlighting; a bookmark can be
#     removed while keeping its EMS history
#   - Modal fzf UI (NORMAL / SEARCH), smart preview, manual curation (delete/undo)
#   - Two search modes (SEARCH_MODE), see "Default configuration" below:
#       sqlite (default)  query the DB on every keystroke -> ordered/any-order
#                         multi-word matching + match-quality grading
#       fzf               load everything up front -> zero-latency filtering of
#                         the abbreviated display column
#   - Match-quality grading can be disabled with GRADE_MODE=off (rank by EMS)
#
# Ranking model (v3): decay on write, align on read
#   write: score = score * exp(-LAMBDA * Δticks) + 1
#   read:  current = score * exp(-LAMBDA * (T_now - tick))
#   where Δticks = global event-clock delta (one tick per add; idle costs none).
#   score only changes when the entry itself is visited, so it is only valid for
#   the tick at that moment; different entries hold scores at different ticks and
#   cannot be compared directly. Sorting / cleanup / display always use current,
#   aligning every entry to the same moment.
#   Maintenance is capacity-based only: the table is capped at MAX_ENTRIES
#   (trimming to PRUNE_FILL_PERCENT of it, 95% by default). There is no score
#   threshold: a low score only affects ranking, never retention.
#   Half-life = ln(2)/LAMBDA visits. The unified `file` history pools
#   directory visits and file opens, so it defaults to LAMBDA=0.005 (about
#   139 visits); other topics keep 0.01 (about 69 visits).
#   This prevents old entries from dominating forever and avoids losing all
#   history after a long break.
#
# Usage:
#    frecency <topic> init                     : initialize/migrate the database
#    frecency <topic> add [--route targets] <content> [keyword]
#                                              : record to unified/typed tables
#    frecency file_dir <action>                : directory-only history in file.db
#    frecency file_file <action>               : file-only history in file.db
#    frecency <topic> unbook <content>         : remove bookmark, keep EMS history
#    frecency <topic> query [search_term]      : open the fzf UI
#    frecency <topic> fzf-action <mode> <path>  : NORMAL-mode copy/edit/view helper
#    frecency <topic> jump-handler [--picker] [--emit=path] [term]
#                                              : shell / vifm integration
#    frecency <topic> remove <content>         : delete an entry (undoable)
#    frecency <topic> recent <seconds> [content]
#                                              : exit 0 if the entry <content>
#                                                (any entry when omitted) was
#                                                updated within the last N seconds
#    frecency <topic> cleanup                  : manual capacity maintenance
#
# The generic interface accepts comma-separated topics; `file`, `file_dir`, and
# `file_file` share file.db and address the unified, directory, and file histories.
#    frecency topic-a,topic-b add /path/to/x
#
# Dependencies:
#    - Core: bash (4.4+), sqlite3 (>=3.35.0 with exp()), fzf (>=0.48.0), file,
#      coreutils, flock
#    - Optional: eza (directory preview), bat / highlight (syntax highlighting)
#    - Deployment self-check: frecency-test (writes the sqlite3 selection cache)
# ============================================================================

# Only supply a UTF-8 locale when the user has none configured at all; never
# override an existing LANG/LC_ALL (LC_ALL wins over every other variable and
# would also leak into child tools like fzf/eza/bat, changing their message
# language and sort order). C.UTF-8 ships with glibc and musl, unlike
# en_US.UTF-8 which may not be generated on minimal/container systems.
if [[ -z ${LC_ALL:-} && -z ${LANG:-} ]]; then
    export LC_ALL=C.UTF-8
fi

# Field separator: ASCII UNIT SEPARATOR. It practically never appears in paths,
# avoiding the old \t problem where a TAB in a path truncated the entry.
SEP=$'\x1f'

SCHEMA_VERSION=4

# --- Paths and Identity ---
# XDG_DATA_HOME is honored for the data/cache directory; the default keeps the
# historical ~/.local/share/frecency location so existing databases are found.
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/frecency"
mkdir -p "$DATA_DIR"
SELF=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SELF")
TOPIC="${1:-default}"
ACTION="$2"
[ -n "$ACTION" ] && shift 2
ENTRY_TABLE=entries
TRASH_TABLE=deleted_entries
TICK_KEY=tick

# --- Architecture detection (must match frecency-test) ---
_sqlite_arch=""
case "$(uname -m)" in
    x86_64|amd64)  _sqlite_arch="x86_64" ;;
    aarch64|arm64) _sqlite_arch="arm64" ;;
esac

# --- Default configuration (overridable by <topic>.config) ---
MAX_ENTRIES=            # fallback capacity; empty means 1000 (unified pool: 2000)
MAX_ENTRIES_UNIFIED=    # per-table override; empty falls back to MAX_ENTRIES
MAX_ENTRIES_DIR=
MAX_ENTRIES_FILE=
QUERY_LIMIT=32          # max rows returned per picker query; 0 = all matches
PRUNE_FILL_PERCENT=     # trim target as a percentage of the limit; empty means 95
_PRUNE_FILL_PERCENT=    # deprecated alias for PRUNE_FILL_PERCENT
SLEEP_DELAY=0.02    # reload debounce for sqlite mode; fzf cancels superseded reloads
START_DATA=all      # 'last' recent entries / 'all' everything
START_MODE=search   # 'normal' (Vim keys) / 'search' (type directly)
LAST_LIMIT=15
MAX_PATH_CHARS=60  # display width (ASCII 1, non-ASCII 2); abbreviate only beyond this
# Search modes (both are kept; switch per topic in <topic>.config):
#   sqlite  queries the DB on every keystroke. In exchange it knows the query and can:
#             · match multi-word queries in order (default) or any order (press s)
#             · grade match quality: keyword hits use keyword grades; path hits use
#               path grades
#   fzf     loads everything into memory at start: zero keystroke latency and no
#             reload debounce, but cannot match hidden middle path segments and does
#             not do query-aware grading.
SEARCH_MODE=sqlite
# Match-quality grading (only in SEARCH_MODE=sqlite and with a query):
#   on   (default) hard grade by keyword/path hit quality, EMS within each grade;
#        lifts exact basename matches among ordinary history entries
#   off  skip grading; every match is ordered by score_cur (multi-word filtering
#        still applies). This is jghub's stance (fzf#4789): grading is a hard-coded
#        preference that can override real usage history.
GRADE_MODE=on
MULTIWORD_MODE=ordered # ordered (default) or any-order; toggled with s in sqlite UI
LAMBDA=0.01         # decay constant (per visit); half-life = ln2/LAMBDA
# Effective decay constants for the destinations a single `add --route` may
# touch. The main router refreshes these per logical topic; the unified file
# history uses half the baseline because its clock also counts file events.
_LAMBDA_UNIFIED=0.01
_LAMBDA_DIR=0.01
_LAMBDA_FILE=0.01
UNDO_KEEP=200       # number of deleted_entries kept
RECORD_UNIFIED=1    # shared file history; set to 0 in file.config to disable
RECORD_SPLIT=1      # directory/file-specific history; set to 0 to disable
IGNORE_PATTERNS=(
    "*/fuse"        # FUSE mount point
    "*/fuse/*"      # files inside FUSE mounts
    "*/.git"        # Git metadata
    "*/.git/*"
    "*/tmp/*"       # temporary files
)

# --- ANSI colors ---
C_NORMAL=$'\e[0m'
C_BOLD=$'\e[1m'
C_GREEN=$'\e[32m'
C_CYAN=$'\e[36m'
C_BLUE=$'\e[34m'
C_RED=$'\e[31m'
C_YELLOW=$'\e[33m'

# ============================================================================
# sqlite3 selection: cache > system (adequate version) > bundled static binary
# ============================================================================
# The bundled static binary is a fallback for machines without sqlite3. On a
# machine with a system sqlite3 it is actually slower (40ms vs 3ms startup in
# testing), so the system version wins by default. The choice is cached in
# $DATA_DIR/.sqlite3.bin: probe only when the cache is missing, then zero cost.
# frecency-test rewrites this cache.
_SQLITE_MIN=3035000   # 3.35.0 (minimum for exp(); runtime probe covers build flags)
_FZF_MIN="0.48.0"     # minimum for --accept-nth / change-footer / rebind / --tmux
SQLITE3=""

_ver_num() { awk -F. '{printf "%d", ($1*1000000)+($2*1000)+$3}' <<< "$1"; }

_sqlite_ok() {
    local b="$1" v
    v=$("$b" --version 2>/dev/null | awk '{print $1}') || return 1
    [[ -n "$v" ]] || return 1
    [[ $(_ver_num "$v") -ge $_SQLITE_MIN ]]
}

_resolve_sqlite3() {
    local cache="$DATA_DIR/.sqlite3.bin" p
    if [[ -s "$cache" ]]; then
        p=$(<"$cache")
        if [[ -n "$p" && ( -x "$p" || -n "$(command -v "$p" 2>/dev/null)" ) ]]; then
            SQLITE3="$p"; return 0
        fi
    fi
    local sys bundled
    sys=$(command -v sqlite3 2>/dev/null)
    bundled=""
    if [[ -n "$_sqlite_arch" ]]; then
        # Repo layout is bundled/sqlite3-<arch>; the installer flattens it to
        # sqlite3-<arch> inside the vifm scripts directory.
        bundled="$SCRIPT_DIR/sqlite3-$_sqlite_arch"
        [[ -x "$bundled" ]] || bundled="$SCRIPT_DIR/../bundled/sqlite3-$_sqlite_arch"
    fi
    if [[ -n "$sys" ]] && _sqlite_ok "$sys"; then
        SQLITE3="$sys"
    elif [[ -n "$bundled" && -x "$bundled" ]] && _sqlite_ok "$bundled"; then
        SQLITE3="$bundled"
    else
        SQLITE3="${sys:-${bundled:-sqlite3}}"
    fi
    printf '%s' "$SQLITE3" > "$cache" 2>/dev/null
}
_resolve_sqlite3

# ============================================================================
# SQL helpers
# ============================================================================
# Convert any value into a safe SQL string literal (' -> '').
# This is the only correct escaping method; the old .parameter + double-quote
# approach was text interpolation and silently swallowed backslashes, failed on
# double quotes, and broke the statement on newlines.
sql_lit() { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }

# Escape ! / % / _ when building LIKE patterns, and use ESCAPE '!' with them;
# otherwise user-supplied % / _ are treated as wildcards.
sql_like() {
    local s=${1//!/!!}
    s=${s//%/!%}
    s=${s//_/!_}
    sql_lit "%$s%"
}

sql_like_prefix() {
    local s=${1//!/!!}
    s=${s//%/!%}
    s=${s//_/!_}
    sql_lit "$s%"
}

sql_like_segment_prefix() {
    local s=${1//!/!!}
    s=${s//%/!%}
    s=${s//_/!_}
    sql_lit "%/$s%"
}

# Combine a multi-word query into an ordered LIKE pattern, e.g.
# "foo bar" -> "%foo%bar%". LIKE wildcards inside each word are still escaped
# literally; the % between words is the ordered gap.
sql_like_ordered() {
    local -a words=()
    read -r -a words <<< "$1"
    local pattern="" word escaped
    for word in "${words[@]}"; do
        escaped=${word//!/!!}
        escaped=${escaped//%/!%}
        escaped=${escaped//_/!_}
        [[ -n "$pattern" ]] && pattern+="%"
        pattern+="$escaped"
    done
    sql_lit "%$pattern%"
}

sql_like_ordered_prefix() {
    local -a words=()
    read -r -a words <<< "$1"
    local pattern="" word escaped
    for word in "${words[@]}"; do
        escaped=${word//!/!!}
        escaped=${escaped//%/!%}
        escaped=${escaped//_/!_}
        [[ -n "$pattern" ]] && pattern+="%"
        pattern+="$escaped"
    done
    sql_lit "$pattern%"
}

_all_words_like_expr() {
    local column="$1" expression="" word
    shift
    for word in "$@"; do
        [[ -n "$expression" ]] && expression+=" AND "
        expression+="$column LIKE $(sql_like "$word") ESCAPE '!'"
    done
    printf '(%s)' "$expression"
}

# Query grade: shared by list ordering and preview to avoid logic drift.
_query_grade_expr() {
    local term="$1" last_word="$2" mode="${3:-ordered}"
    local -a words=()
    read -r -a words <<< "$term"
    local full prefix contains lw lw_prefix lw_contains path_prefix hidden_prefix
    full=$(sql_lit "$term")
    if [[ "$mode" == "ordered" ]]; then
        prefix=$(sql_like_ordered_prefix "$term")
        contains=$(sql_like_ordered "$term")
    else
        local first_prefix rest_matches
        first_prefix="keyword LIKE $(sql_like_prefix "${words[0]}") ESCAPE '!'"
        rest_matches=$(_all_words_like_expr keyword "${words[@]:1}")
        [[ -n "${words[*]:1}" ]] && prefix="($first_prefix AND $rest_matches)" \
            || prefix="($first_prefix)"
        contains=$(_all_words_like_expr keyword "${words[@]}")
    fi
    lw=$(sql_lit "$last_word")
    lw_prefix=$(sql_like_prefix "$last_word")
    lw_contains=$(sql_like "$last_word")
    path_prefix=$(sql_like_segment_prefix "$last_word")
    hidden_prefix=$(sql_like_segment_prefix ".$last_word")
    if [[ "$mode" == "ordered" ]]; then
        printf "(CASE
        WHEN keyword = %s THEN 0
        WHEN keyword LIKE %s ESCAPE '!' THEN 1
        WHEN keyword LIKE %s ESCAPE '!' THEN 2
        WHEN last_seg = %s THEN 3
        WHEN last_seg LIKE %s ESCAPE '!' THEN 4
        WHEN last_seg LIKE %s ESCAPE '!' THEN 5
        WHEN content LIKE %s ESCAPE '!' OR content LIKE %s ESCAPE '!' THEN 6
        ELSE 7 END)" \
            "$full" "$prefix" "$contains" "$lw" "$lw_prefix" "$lw_contains" "$path_prefix" "$hidden_prefix"
    else
        printf "(CASE
        WHEN keyword = %s THEN 0
        WHEN %s THEN 1
        WHEN %s THEN 2
        WHEN last_seg = %s THEN 3
        WHEN last_seg LIKE %s ESCAPE '!' THEN 4
        WHEN last_seg LIKE %s ESCAPE '!' THEN 5
        WHEN content LIKE %s ESCAPE '!' OR content LIKE %s ESCAPE '!' THEN 6
        ELSE 7 END)" \
            "$full" "$prefix" "$contains" "$lw" "$lw_prefix" "$lw_contains" "$path_prefix" "$hidden_prefix"
    fi
}

_current_multiword_mode() {
    local mode="${MULTIWORD_MODE:-ordered}"
    if [[ -n "${FRECENCY_ORDER_FILE:-}" && -r "$FRECENCY_ORDER_FILE" ]]; then
        IFS= read -r mode < "$FRECENCY_ORDER_FILE" || true
    fi
    [[ "$mode" == "any-order" ]] || mode="ordered"
    printf '%s' "$mode"
}

# Pass SQL through stdin so heredoc shell expansion cannot interfere.
run_sql() {
    { printf '%s\n' ".timeout 5000"; printf '%s\n' "$1"; } \
        | "$SQLITE3" -batch -bail -list -separator "$SEP" -init /dev/null "$DB_PATH"
}

# Safely wrap any string in single quotes (for generated cd / goto commands).
shq() { local s=${1//\'/\'\\\'\'}; printf '%s' "$s"; }

# Unsigned decimal integer: reject leading zeros so '08' is never parsed as an
# octal number by $(( )) (which would silently skip capacity cleanup or error).
_is_uint() { [[ ${1:-} =~ ^(0|[1-9][0-9]*)$ ]]; }
# Arithmetic-safe decimal value (belt-and-braces for config coming from source).
# Must use $(( )) arithmetic: printf '%d' parses with strtol and silently stops
# at the '#' ("10#1000" -> 10), which made capacity cleanup prune to 1 row.
_dec() { printf '%s' "$(( 10#${1:-0} ))"; }
# Non-negative decimal number (integer or float), for SLEEP_DELAY / LAMBDA.
_is_num() { [[ ${1:-} =~ ^([0-9]+([.][0-9]+)?|[.][0-9]+)$ ]]; }

# The three file.db tables share file.config for their per-table limits and
# trim target. When a split topic (file_dir/file_file) is invoked directly,
# pick up those values from file.config without changing the rest of that
# topic's configuration.
_SHARED_LIMITS_LOADED=0
_load_shared_file_limits() {
    (( _SHARED_LIMITS_LOADED )) && return 0
    [[ "$DB_PATH" == "$DATA_DIR/file.db" ]] || return 0
    [[ "$CONFIG_PATH" == "$DATA_DIR/file.config" ]] && return 0
    [[ -f "$DATA_DIR/file.config" ]] || return 0
    _SHARED_LIMITS_LOADED=1
    local vals base uni dir file pct legacy_pct
    vals=$( ( source "$DATA_DIR/file.config" >/dev/null 2>&1
              printf '%s\n' \
                  "${MAX_ENTRIES-}" "${MAX_ENTRIES_UNIFIED-}" \
                  "${MAX_ENTRIES_DIR-}" "${MAX_ENTRIES_FILE-}" \
                  "${PRUNE_FILL_PERCENT-}" "${_PRUNE_FILL_PERCENT-}" ) 2>/dev/null ) || return 0
    { IFS= read -r base; IFS= read -r uni; IFS= read -r dir; IFS= read -r file
      IFS= read -r pct; IFS= read -r legacy_pct; } <<< "$vals"
    [[ -n "${MAX_ENTRIES:-}" ]] || MAX_ENTRIES=$base
    [[ -n "${MAX_ENTRIES_UNIFIED:-}" ]] || MAX_ENTRIES_UNIFIED=$uni
    [[ -n "${MAX_ENTRIES_DIR:-}" ]] || MAX_ENTRIES_DIR=$dir
    [[ -n "${MAX_ENTRIES_FILE:-}" ]] || MAX_ENTRIES_FILE=$file
    [[ -n "${PRUNE_FILL_PERCENT:-}" ]] || PRUNE_FILL_PERCENT=$pct
    [[ -n "${_PRUNE_FILL_PERCENT:-}" ]] || _PRUNE_FILL_PERCENT=$legacy_pct
}

# Trim target as a percentage of the capacity limit. Empty or invalid values
# (outside 50..100) fall back to 95. The pre-release `_PRUNE_FILL_PERCENT` name
# is still accepted as a fallback alias.
_prune_fill_percent() {
    _load_shared_file_limits
    local pct="${PRUNE_FILL_PERCENT:-}"
    [[ -n "$pct" ]] || pct="${_PRUNE_FILL_PERCENT:-}"
    _is_uint "$pct" || pct=95
    (( pct >= 50 && pct <= 100 )) || pct=95
    printf '%s' "$pct"
}

# Capacity limit for a history destination. Empty per-table values fall back to
# MAX_ENTRIES; 0 disables automatic pruning for that table. The unified pool
# holds directories and files together and its event clock ticks about twice
# as fast, so with no explicit MAX_ENTRIES it defaults to twice the capacity
# of the split dir/file tables.
_limit_for_dest() {
    _load_shared_file_limits
    local base="${MAX_ENTRIES:-1000}"
    _is_uint "$base" || base=1000
    local uni_base=$base
    [[ -n "${MAX_ENTRIES:-}" ]] || uni_base=2000
    case "$1" in
        unified) printf '%s' "${MAX_ENTRIES_UNIFIED:-$uni_base}" ;;
        dir)     printf '%s' "${MAX_ENTRIES_DIR:-$base}" ;;
        file)    printf '%s' "${MAX_ENTRIES_FILE:-$base}" ;;
    esac
}

_dest_for_current_table() {
    case "$ENTRY_TABLE" in
        dir_entries)  printf 'dir' ;;
        file_entries) printf 'file' ;;
        *)            printf 'unified' ;;
    esac
}

_require_sqlite3() {
    if [[ ! -x "$SQLITE3" ]] && ! command -v "$SQLITE3" >/dev/null 2>&1; then
        printf 'frecency: no usable sqlite3 found (%s)\n' "$SQLITE3" >&2
        exit 127
    fi
}
_require_fzf() {
    if ! command -v fzf >/dev/null 2>&1; then
        printf 'frecency: fzf not found\n' >&2
        exit 127
    fi
    # Version gate: requires 0.48+ features (--accept-nth / change-footer / rebind / --tmux).
    local v; v=$(fzf --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
    if [[ -n "$v" ]] && (( $(_ver_num "$v") < $(_ver_num "$_FZF_MIN") )); then
        printf 'frecency: fzf %s is too old; need >= %s (--accept-nth / change-footer / rebind)\n' \
            "$v" "$_FZF_MIN" >&2
        exit 127
    fi
}

# ============================================================================
# Database
# ============================================================================
do_init() {
    # Remember the pre-migration version: v2 -> v3 must reset scores polluted by
    # PIN_BASE. On a fresh database this is empty (SELECT fails without a meta table).
    local prev=""
    prev=$(run_sql "SELECT v FROM meta WHERE k = 'schema_version';" 2>/dev/null) || prev=""
    # Order matters: create tables and migrate (ALTER ADD COLUMN) first, then indexes.
    # --- Step 1: tables / trash / meta (no indexes) ---
    run_sql "
PRAGMA journal_mode = WAL;
PRAGMA synchronous = NORMAL;
PRAGMA cache_size = -2000;

CREATE TABLE IF NOT EXISTS entries (
    content TEXT PRIMARY KEY,
    keyword TEXT DEFAULT '',
    score REAL DEFAULT 1.0,
    visits INTEGER DEFAULT 1,
    tick INTEGER DEFAULT 0,
    last_access DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS deleted_entries (
    content TEXT PRIMARY KEY,
    keyword TEXT,
    score REAL,
    deleted_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);

INSERT OR IGNORE INTO meta VALUES ('schema_version','$SCHEMA_VERSION'), ('tick','0');
INSERT OR IGNORE INTO meta VALUES ('dir_tick','0'), ('file_tick','0');

CREATE TABLE IF NOT EXISTS dir_entries (
    content TEXT PRIMARY KEY, keyword TEXT DEFAULT '', score REAL DEFAULT 1.0,
    visits INTEGER DEFAULT 1, tick INTEGER DEFAULT 0,
    last_access DATETIME DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS file_entries (
    content TEXT PRIMARY KEY, keyword TEXT DEFAULT '', score REAL DEFAULT 1.0,
    visits INTEGER DEFAULT 1, tick INTEGER DEFAULT 0,
    last_access DATETIME DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS dir_deleted_entries (
    content TEXT PRIMARY KEY, keyword TEXT, score REAL,
    deleted_at DATETIME DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS file_deleted_entries (
    content TEXT PRIMARY KEY, keyword TEXT, score REAL,
    deleted_at DATETIME DEFAULT CURRENT_TIMESTAMP
);
" >/dev/null 2>&1 || {
        printf 'frecency: failed to create base database schema: %s\n' "$DB_PATH" >&2
        return 1
    }

    # --- Step 2: v1 -> v2 migration; ALTER only missing columns ---
    # Check columns before ALTER to stay idempotent; -bail stops on the first error.
    local have alters=""
    have=$(run_sql "SELECT group_concat(name) FROM pragma_table_info('entries')
                    WHERE name IN ('visits','tick');") || {
        printf 'frecency: cannot read database columns: %s\n' "$DB_PATH" >&2
        return 1
    }
    [[ "$have" != *visits* ]] && alters+="ALTER TABLE entries ADD COLUMN visits INTEGER DEFAULT 1;"$'\n'
    [[ "$have" != *tick*   ]] && alters+="ALTER TABLE entries ADD COLUMN tick INTEGER DEFAULT 0;"$'\n'
    if [[ -n "$alters" ]]; then
        run_sql "$alters
UPDATE entries SET visits = 1 WHERE visits IS NULL;
UPDATE entries SET tick = 0 WHERE tick IS NULL;" >/dev/null 2>&1 || {
            printf 'frecency: database column migration failed: %s\n' "$DB_PATH" >&2
            return 1
        }
    fi

    # --- v2 -> v3: bookmarks are no longer pinned at a constant 9999 score ---
    # v2 lifted entries with a keyword to PIN_BASE, an artificial constant unrelated
    # to EMS. Scores must return to real history; otherwise removing the old
    # constant still leaves old bookmarks dominating for a long time.
    if [[ "$prev" == "2" ]]; then
        run_sql "UPDATE entries SET score = 1.0 WHERE keyword != '' AND score >= 1000;" >/dev/null 2>&1 || {
            printf 'frecency: bookmark score migration failed: %s\n' "$DB_PATH" >&2
            return 1
        }
    fi

    # --- Step 3: indexes (the tick column must already exist) ---
    run_sql "
CREATE INDEX IF NOT EXISTS idx_entries_frecency ON entries (score DESC, last_access DESC);
CREATE INDEX IF NOT EXISTS idx_entries_keyword ON entries (keyword) WHERE keyword != '';
CREATE INDEX IF NOT EXISTS idx_entries_tick ON entries (tick);
CREATE INDEX IF NOT EXISTS idx_deleted_at ON deleted_entries (deleted_at DESC);
CREATE INDEX IF NOT EXISTS idx_dir_frecency ON dir_entries (score DESC, last_access DESC);
CREATE INDEX IF NOT EXISTS idx_dir_keyword ON dir_entries (keyword) WHERE keyword != '';
CREATE INDEX IF NOT EXISTS idx_dir_tick ON dir_entries (tick);
CREATE INDEX IF NOT EXISTS idx_dir_deleted_at ON dir_deleted_entries (deleted_at DESC);
CREATE INDEX IF NOT EXISTS idx_file_frecency ON file_entries (score DESC, last_access DESC);
CREATE INDEX IF NOT EXISTS idx_file_keyword ON file_entries (keyword) WHERE keyword != '';
CREATE INDEX IF NOT EXISTS idx_file_tick ON file_entries (tick);
CREATE INDEX IF NOT EXISTS idx_file_deleted_at ON file_deleted_entries (deleted_at DESC);
UPDATE meta SET v = '$SCHEMA_VERSION' WHERE k = 'schema_version';
" >/dev/null 2>&1 || {
        printf 'frecency: failed to create indexes or update schema version: %s\n' "$DB_PATH" >&2
        return 1
    }
}

# Initialization/migration is serialized with flock. After waiting for the lock,
# re-check the marker so concurrent first runs do not migrate twice.
# The marker is written with an atomic rename only after migration and the exp()
# probe succeed.
_initialize() {
    local force="${1:-0}" lock_fd tmp_marker
    local mv=""
    [[ -s "$MARKER" ]] && read -r mv < "$MARKER"
    [[ "$force" != 1 && "$mv" == "$SCHEMA_VERSION" ]] && return 0
    if ! command -v flock >/dev/null 2>&1; then
        printf 'frecency: initialization requires flock (util-linux)\n' >&2
        return 1
    fi
    exec {lock_fd}>"${LOCK_FILE}" || return 1
    flock -x "$lock_fd" || { exec {lock_fd}>&-; return 1; }

    mv=""
    [[ -s "$MARKER" ]] && read -r mv < "$MARKER"
    if [[ "$force" == 1 || "$mv" != "$SCHEMA_VERSION" ]]; then
        do_init || { exec {lock_fd}>&-; return 1; }
        _require_math_functions
        if [[ -f "$DB_PATH" ]]; then
            tmp_marker="${MARKER}.$$"
            if ! printf '%s\n' "$SCHEMA_VERSION" > "$tmp_marker" || ! mv -f -- "$tmp_marker" "$MARKER"; then
                rm -f -- "$tmp_marker"
                printf 'frecency: cannot write database ready marker: %s\n' "$MARKER" >&2
                exec {lock_fd}>&-
                return 1
            fi
        fi
    fi
    exec {lock_fd}>&-
}

_ensure_ready() {
    _initialize 0
}

# exp() requires SQLite >= 3.35 built with SQLITE_ENABLE_MATH_FUNCTIONS.
# This is a hard requirement with no approximate fallback: interpolation/step
# implementations are complex and any approximation creates ties at grade
# boundaries, breaking the total order of EMS (same problem as the old 0.05 floor).
# If missing, fail loudly and ask the user to upgrade; mainstream distributions
# ship sqlite3 >= 3.35 with math functions.
_require_math_functions() {
    [[ "$(run_sql "SELECT printf('%.4f', exp(1));" 2>/dev/null)" == "2.7183" ]] && return 0
    printf 'frecency: this sqlite3 (%s) lacks the exp() math function; EMS decay cannot be computed.\n' \
        "$("$SQLITE3" --version 2>/dev/null | awk '{print $1}')" >&2
    printf '  Upgrade to sqlite3 >= 3.35.0 (built with SQLITE_ENABLE_MATH_FUNCTIONS;\n' >&2
    printf '  mainstream distribution builds include it), or run frecency-test for a self-check.\n' >&2
    exit 1
}

# Current score: align stored from "the entry's own tick" to "the current tick".
# Write and read share the same expression:
#   write score = <expr> + 1   (meta.tick was already incremented; expr subtracts old tick)
#   read current = <expr>      (sorting / cleanup / display must use this, not stored)
_decay_expr() {
    local dt="((SELECT CAST(v AS INTEGER) FROM meta WHERE k = '$TICK_KEY') - tick)"
    printf 'score * exp(-%s * %s)' "$LAMBDA" "$dt"
}

# Delete the unbookmarked rows that rank below `keep` (lowest current score
# first). `protect` is the content just written, so a new entry is not
# immediately removed by its own capacity check.
_prune_table() {
    local table="$1" tick_key="$2" lambda="$3" keep="$4" protect="${5:-}"
    local protect_sql=""
    [[ -n "$protect" ]] && protect_sql="AND content <> $(sql_lit "$protect")"
    run_sql "
DELETE FROM $table
 WHERE keyword = ''
   $protect_sql
   AND content IN (SELECT content FROM $table
                    WHERE keyword = ''
                      $protect_sql
                    ORDER BY score * exp(-$lambda * (
                                 (SELECT CAST(v AS INTEGER) FROM meta WHERE k = '$tick_key') - tick
                             )) DESC,
                             last_access DESC, content
                    LIMIT -1 OFFSET $keep);" >/dev/null
}

do_cleanup() {
    _ensure_ready || return 1
    local limit keep n pct
    limit=$(_limit_for_dest "$(_dest_for_current_table)")
    if _is_uint "$limit" && (( $(_dec "$limit") > 0 )); then
        # A maintenance pass must not shorten a table that is still below its
        # capacity: the fill percentage is hysteresis, not a second cap. Only
        # trim when the table actually exceeds MAX_ENTRIES.
        n=$(run_sql "SELECT COUNT(*) FROM $ENTRY_TABLE WHERE keyword = '';")
        if _is_uint "$n" && (( $(_dec "$n") > $(_dec "$limit") )); then
            pct=$(_prune_fill_percent)
            keep=$(( $(_dec "$limit") * pct / 100 ))
            (( keep >= 1 )) || keep=1
            _prune_table "$ENTRY_TABLE" "$TICK_KEY" "$LAMBDA" "$keep" || return 1
        fi
    fi
    run_sql "
DELETE FROM $TRASH_TABLE
 WHERE content NOT IN (SELECT content FROM $TRASH_TABLE
                        ORDER BY deleted_at DESC LIMIT $UNDO_KEEP);" >/dev/null
}

# ============================================================================
# Write: event clock + exponential decay
# ============================================================================
_do_upsert() {
    local content="$1" keyword="$2"
    # The first insert does not go through ON CONFLICT; its initial score is one event.
    # keyword only participates in grading when the query hits it, and exempts the
    # entry from cleanup; it no longer inflates the EMS score.
    run_sql "
BEGIN IMMEDIATE;
UPDATE meta SET v = CAST(CAST(v AS INTEGER) + 1 AS TEXT) WHERE k = '$TICK_KEY';
INSERT INTO $ENTRY_TABLE (content, keyword, score, visits, tick, last_access)
VALUES ($(sql_lit "$content"), $(sql_lit "$keyword"), 1.0, 1,
        (SELECT CAST(v AS INTEGER) FROM meta WHERE k = '$TICK_KEY'), CURRENT_TIMESTAMP)
ON CONFLICT(content) DO UPDATE SET
    keyword = CASE WHEN $(sql_lit "$keyword") != '' THEN $(sql_lit "$keyword") ELSE keyword END,
    -- No floor: decaying to 1e-100 just means the next +1 is nearly 1; a floor only
    -- creates ties.
    score = $(_decay_expr) + 1,
    visits = visits + 1,
    tick = (SELECT CAST(v AS INTEGER) FROM meta WHERE k = '$TICK_KEY'),
    last_access = CURRENT_TIMESTAMP;
COMMIT;
" >/dev/null
}

_do_upsert_route() {
    local content="$1" keyword="$2" route_sql="BEGIN IMMEDIATE;" count_sql="" dest table tick_key lambda
    local -a dests=() tables=() ticks=() lambdas=()
    for dest in "${_route_targets[@]}"; do
        case "$dest" in
            unified) table=entries; tick_key=tick; lambda=$_LAMBDA_UNIFIED ;;
            dir) table=dir_entries; tick_key=dir_tick; lambda=$_LAMBDA_DIR ;;
            file) table=file_entries; tick_key=file_tick; lambda=$_LAMBDA_FILE ;;
            *) continue ;;
        esac
        dests+=("$dest"); tables+=("$table"); ticks+=("$tick_key"); lambdas+=("$lambda")
        route_sql+="
UPDATE meta SET v = CAST(CAST(v AS INTEGER) + 1 AS TEXT) WHERE k = '$tick_key';
INSERT INTO $table (content, keyword, score, visits, tick, last_access)
VALUES ($(sql_lit "$content"), $(sql_lit "$keyword"), 1.0, 1,
        (SELECT CAST(v AS INTEGER) FROM meta WHERE k = '$tick_key'), CURRENT_TIMESTAMP)
ON CONFLICT(content) DO UPDATE SET
    keyword = CASE WHEN $(sql_lit "$keyword") != '' THEN $(sql_lit "$keyword") ELSE keyword END,
    score = score * exp(-$lambda * ((SELECT CAST(v AS INTEGER) FROM meta WHERE k = '$tick_key') - tick)) + 1,
    visits = visits + 1,
    tick = (SELECT CAST(v AS INTEGER) FROM meta WHERE k = '$tick_key'),
    last_access = CURRENT_TIMESTAMP;"
        # Count inside the same transaction: one sqlite3 process serves the
        # write and the capacity checks for every destination.
        count_sql+="SELECT COUNT(*) FROM $table WHERE keyword = '';"$'\n'
    done
    route_sql+=$'\n'"$count_sql"$'\nCOMMIT;'

    # Pruning runs after the commit so the write lock is not held while sorting;
    # the counts from the same invocation drive the capacity check.
    local out i limit n keep pct
    out=$(run_sql "$route_sql") || return 1
    local -a counts=()
    mapfile -t counts <<< "$out"
    pct=$(_prune_fill_percent)
    for i in "${!dests[@]}"; do
        n="${counts[$i]:-}"
        _is_uint "$n" || continue
        limit=$(_limit_for_dest "${dests[$i]}")
        _is_uint "$limit" || continue
        limit=$(_dec "$limit")
        (( limit > 0 )) || continue
        if (( $(_dec "$n") > limit )); then
            keep=$(( limit * pct / 100 ))
            (( keep >= 1 )) || keep=1
            _prune_table "${tables[$i]}" "${ticks[$i]}" "${lambdas[$i]}" "$keep" "$content" || return 1
        fi
    done
}

do_add() {
    local content="" keyword="" route="unified"
    [[ "$TOPIC" == "file_dir" ]] && route="dir"
    [[ "$TOPIC" == "file_file" ]] && route="file"
    while (($#)); do
        case "$1" in
            --route)
                (($# >= 2)) || { printf 'Usage: frecency <topic> add [--route unified[,dir][,file]] <content> [keyword]\n' >&2; return 2; }
                route="$2"; shift 2 ;;
            --route=*) route="${1#*=}"; shift ;;
            *)
                if [[ -z "$content" ]]; then content="$1"; else keyword="$1"; fi
                shift ;;
        esac
    done
    [[ -n "$content" ]] || { printf 'Usage: frecency <topic> add [--route destinations] <content> [keyword]\n' >&2; return 2; }
    # The query/UI output protocol is line-based with SEP as a field delimiter;
    # a newline or SEP inside a path would break row parsing on read. Reject
    # such paths at write time rather than storing unreadable records.
    if [[ "$content" == *$'\n'* || "$content" == *$'\r'* || "$content" == *"$SEP"* ]]; then
        printf 'frecency: refusing to record a path containing a newline or separator\n' >&2
        return 2
    fi

    for pattern in "${IGNORE_PATTERNS[@]}"; do
        # shellcheck disable=SC2053  # $pattern is an intentional glob from config
        [[ "$content" == $pattern ]] && return 0
    done

    _ensure_ready || return 1
    local dest
    local -a requested_targets=()
    IFS=',' read -r -a requested_targets <<< "$route"
    _route_targets=()
    local -A _route_seen=()
    for dest in "${requested_targets[@]}"; do
        case "$dest" in unified|dir|file) ;; *)
            printf 'frecency: invalid --route destination: %s\n' "$dest" >&2
            return 2 ;;
        esac
        [[ -n "${_route_seen[$dest]:-}" ]] && continue
        _route_seen[$dest]=1
        case "$dest" in
            unified)
                [[ "$RECORD_UNIFIED" == 1 ]] || continue
                ;;
            dir|file)
                [[ "$RECORD_SPLIT" == 1 ]] || continue ;;
        esac
        _route_targets+=("$dest")
    done
    ((${#_route_targets[@]})) || return 0
    _do_upsert_route "$content" "$keyword" || return 1

    # Low-frequency background maintenance: trim the undo table and act as a
    # safety net for concurrent writers. do_cleanup only prunes a table that is
    # actually over its capacity limit, so this pass cannot shorten a table that
    # is still below it. Probabilistic (0.5%, about once every 200 writes); the
    # normal per-write pruning above is unchanged.
    if (( RANDOM % 200 == 0 )); then
        for dest in "${_route_targets[@]}"; do
            case "$dest" in
                unified) "$SELF" file cleanup >/dev/null 2>&1 & ;;
                dir)     "$SELF" file_dir cleanup >/dev/null 2>&1 & ;;
                file)    "$SELF" file_file cleanup >/dev/null 2>&1 & ;;
            esac
        done
    fi
}

# recent <seconds> [content]: succeed if the entry <content> — or any entry
# when omitted — was updated within the last N seconds. Used by the Neovim
# integration to skip a duplicate record right after vifm's own open hook has
# already written the same file; matching the exact path keeps unrelated writes
# (e.g. a DirEnter directory change) from swallowing the record.
do_recent() {
    local seconds="${1:-5}" content="${2:-}"
    _is_uint "$seconds" || {
        printf 'frecency: recent requires a whole number of seconds: %s\n' "$seconds" >&2
        return 2
    }
    _ensure_ready || return 1
    local where=""
    [[ -n "$content" ]] && where="AND content = $(sql_lit "$content")"
    local hit
    hit=$(run_sql "SELECT 1 FROM $ENTRY_TABLE
                   WHERE last_access >= datetime('now', '-$seconds seconds') $where
                   LIMIT 1;")
    [[ -n "$hit" ]]
}

# ============================================================================
# Preview
# ============================================================================
# Highlight a text file within a line limit; prefer bat, then highlight, then head.
_apply_highlight() {
    local target="$1" limit="$2"
    if command -v bat >/dev/null 2>&1; then
        bat --color=always --style=plain --line-range=:"$limit" -- "$target"
    elif command -v highlight >/dev/null 2>&1; then
        highlight -O ansi --force "$target" | head -n "$limit"
    else
        head -n "$limit" -- "$target"
    fi
}

do_preview() {
    local content="${1##*$SEP}"     # last field = the real path/command
    local db_info
    local path_missing=0
    if [[ "$TOPIC" == file* || "$TOPIC" == "dir" ]] && [[ ! -e "$content" ]]; then
        path_missing=1
    fi

    # Full path: the list column is narrow and long paths get truncated; the first
    # preview line shows the whole path. FZF_PREVIEW_COLUMNS is injected by fzf and
    # fold wraps to the preview width (paths rarely contain spaces, so -s falls back
    # to a hard width cut).
    printf '%s%s%s\n' "${C_CYAN}${C_BOLD}" "--- Full Path ---" "$C_NORMAL"
    if (( path_missing )); then
        printf '\e[9m%s\e[0m\n' "$content" \
            | fold -s -w "${FZF_PREVIEW_COLUMNS:-100}"
    else
        printf '%s\n' "$content" | fold -s -w "${FZF_PREVIEW_COLUMNS:-100}"
    fi
    printf '\n'

    _ensure_ready || return 1

    if [[ -f "$DB_PATH" ]]; then
        # Grade calculation: reproduce the ORDER BY CASE WHEN ladder with
        # FZF_QUERY (the current search term injected by fzf), so the preview grade
        # matches actual ordering. grade is NULL when GRADE_MODE != on or no query.
        local cur_expr
        cur_expr=$(_decay_expr)
        local grade_col="NULL"
        local from_extra=""
        if [[ "${GRADE_MODE:-on}" == "on" && -n "${FZF_QUERY:-}" ]]; then
            local q="$FZF_QUERY"
            local -a preview_words=()
            read -r -a preview_words <<< "$q"
            local last_word="${preview_words[${#preview_words[@]}-1]}"
            from_extra=", REPLACE(content, RTRIM(content, REPLACE(content, '/', '')), '') AS last_seg"
            grade_col=$(_query_grade_expr "$q" "$last_word" "$(_current_multiword_mode)")
        fi

        db_info=$(run_sql "
            SELECT printf('%.4f', $cur_expr) || '$SEP' ||
                   COALESCE(NULLIF(keyword,''), 'None') || '$SEP' ||
                   strftime('%Y-%m-%d %H:%M:%S', last_access, 'localtime') ||
                   '$SEP' || IFNULL(CAST(grade AS TEXT), 'NULL')
            FROM (
                SELECT inner.*, $grade_col AS grade
                FROM (SELECT $ENTRY_TABLE.* $from_extra FROM $ENTRY_TABLE) AS inner
            )
            WHERE content = $(sql_lit "$content") LIMIT 1;")
    fi

    printf '%s%s%s\n' "${C_YELLOW}${C_BOLD}" "--- Metadata ---" "$C_NORMAL"
    if [[ -n "$db_info" ]]; then
        IFS="$SEP" read -r db_score db_key db_time db_grade <<< "$db_info"
        printf 'EMS Score: %s%s%s | Keyword: %s%s%s | Last Access: %s\n' \
            "$C_CYAN" "$db_score" "$C_NORMAL" "$C_GREEN" "${db_key:-None}" "$C_NORMAL" "$db_time"
        if [[ -n "${db_grade:-}" && "${db_grade}" != "NULL" ]]; then
            local grade_label
            case "$db_grade" in
                0)  grade_label="0 keyword == query (exact)" ;;
                1)  grade_label="1 keyword starts with query" ;;
                2)  grade_label="2 keyword contains query" ;;
                3)  grade_label="3 last_seg == query (exact)" ;;
                4)  grade_label="4 last_seg starts with query" ;;
                5)  grade_label="5 last_seg contains query" ;;
                6)  grade_label="6 middle segment starts with query" ;;
                7)  grade_label="7 generic substring match" ;;
                *)  grade_label="$db_grade" ;;
            esac
            printf 'Effective order: %s → EMS %s\n' "$grade_label" "$db_score"
        else
            printf 'Effective order: EMS %s  (no query grade)\n' "$db_score"
        fi
    else
        printf 'Status: %sNew / Unrecorded Item%s\n' "$C_YELLOW" "$C_NORMAL"
    fi
    printf '\n'

    if [[ -e "$content" ]]; then
        if [[ -d "$content" ]]; then
            printf '%s%s%s\n' "${C_BLUE}${C_BOLD}" "--- Directory Contents ---" "$C_NORMAL"
            command -v eza >/dev/null 2>&1 \
                && eza -a --color=always --icons --no-permissions --no-user --no-time --no-filesize -- "$content" | head -n 40 \
                || ls -la --color=always -- "$content" | head -n 40
        else
            local mime desc
            mime=$(file --mime-type -b -- "$content" 2>/dev/null)
            desc=$(file -b -- "$content" 2>/dev/null)
            if [[ "$mime" == text/* || "$desc" == *"text"* || "$desc" == *"script"* ]]; then
                printf '%s%s%s\n' "${C_GREEN}${C_BOLD}" "--- Text Preview ---" "$C_NORMAL"
                _apply_highlight "$content" 100
            else
                printf '%s%s%s\n' "${C_BLUE}${C_BOLD}" "--- Binary File Info ---" "$C_NORMAL"
                file -b -- "$content"; ls -ldh -- "$content" | awk '{print "Size: "$5"\nPerms: "$1"\nOwner: "$3}'
            fi
        fi
    elif [[ "$TOPIC" == file* || "$TOPIC" == "dir" ]]; then
        printf '%s%s%s\n' "${C_RED}${C_BOLD}" "!!! MISSING PATH !!!" "$C_NORMAL"
        printf 'This entry points to a path that no longer exists.\n\n'
        printf 'Available actions:\n'
        printf '%s\n' '- Press d in the picker to delete this record.'
        printf '%s\n' "- Run: frecency $TOPIC remove <path>"
    else
        local cmd_name="${content%% *}"
        local cmd_type
        cmd_type=$(type -t "$cmd_name" 2>/dev/null)
        if [[ -n "$cmd_type" ]]; then
            printf '%s%s%s\n' "${C_GREEN}${C_BOLD}" "--- Command Info ---" "$C_NORMAL"
            printf 'Type: %s%s%s\n' "$C_CYAN" "$cmd_type" "$C_NORMAL"
            case "$cmd_type" in
                alias) alias "$cmd_name" 2>/dev/null || type "$cmd_name" ;;
                file)
                    local real_path r_desc
                    real_path=$(which "$cmd_name" 2>/dev/null)
                    printf '%s%s%s\n----------------------\n' "$C_BLUE" "$real_path" "$C_NORMAL"
                    r_desc=$(file -b "$real_path" 2>/dev/null)
                    if [[ "$r_desc" == *"text"* || "$r_desc" == *"script"* ]]; then
                        printf '%s%s%s\n' "$C_BOLD" "Script Snippet:" "$C_NORMAL"; _apply_highlight "$real_path" 30
                    else
                        file -b "$real_path"
                    fi ;;
                *) type "$cmd_name" | head -n 20 ;;
            esac
        else
            printf '%s%s%s\n%s\n' "${C_BLUE}${C_BOLD}" "--- Raw Entry ---" "$C_NORMAL" "$content"
        fi
    fi
}

# ============================================================================
# Query
# ============================================================================
_do_internal_query() {
    local mode="$1"; local term="$2"; local limit="${3:-}" total_flag="${4:-}"
    _ensure_ready || return 1
    # score_cur = score aligned to the current tick. A stored score is only valid
    # at its own tick; ORDER BY score would compare scores from different moments
    # and produce a meaningless order.
    local cur; cur=$(_decay_expr)
    local where="" sub_extra="" grade_expr="NULL"
    local order="ORDER BY score_cur DESC, last_access DESC"

    if [[ "$mode" == "last" ]]; then
        order="ORDER BY last_access DESC LIMIT $LAST_LIMIT"
    elif [[ "$SEARCH_MODE" == "sqlite" && -n "$term" ]]; then
        # Ordered mode combines words into %foo%bar%; any-order mode still matches
        # word by word. Both require the whole query to hit one field, never half
        # path and half keyword.
        local -a words=()
        read -r -a words <<< "$term"
        local multiword_mode; multiword_mode=$(_current_multiword_mode)
        if [[ "$multiword_mode" == "ordered" ]]; then
            local ordered_pattern; ordered_pattern=$(sql_like_ordered "$term")
            where="WHERE (content LIKE $ordered_pattern ESCAPE '!' OR keyword LIKE $ordered_pattern ESCAPE '!')"
        else
            where="WHERE ($(_all_words_like_expr content "${words[@]}") OR $(_all_words_like_expr keyword "${words[@]}"))"
        fi

        # ---- Match-quality grading (SEARCH_MODE=sqlite only; skipped when GRADE_MODE=off) ----
        # The real target is the last path segment (final file/directory name), so the
        # last segment uses the same three-level semantics as keyword:
        #   exact > prefix > contains
        # If the last segment misses, fall back to middle segments, then any substring.
        #
        # Grade ladder:
        #   0      keyword equals query
        #   1      keyword starts with query
        #   2      keyword contains query
        #   3      last segment equals query        (/a/b/proj)
        #   4      last segment starts with query   (/a/b/proj.conf)
        #   5      last segment contains query      (/a/b/myprojX)
        #   6      a middle path segment starts with query (/a/proj/c/foo)
        #   7      any other substring match
        #
        # Last segment extraction: SQLite has no REVERSE(), so use the RTRIM trick:
        #   REPLACE(content, '/', '') yields the character set without slashes,
        #   RTRIM(content, that set) strips the tail until a slash stops it,
        #   REPLACE(content, remaining prefix, '') extracts the last segment.
        if [[ "${GRADE_MODE:-on}" != "on" ]]; then
            # Grading off: order solely by real aligned EMS; keyword still filters WHERE.
            order="ORDER BY score_cur DESC, last_access DESC"
        else
        # With multiple words, the last word is best for last-segment grading.
        local last_word="${words[${#words[@]}-1]}"
        # Inject last_seg into the subquery; computed only with a query and grading on.
        sub_extra=", REPLACE(content, RTRIM(content, REPLACE(content, '/', '')), '') AS last_seg"
        grade_expr=$(_query_grade_expr "$term" "$last_word" "$multiword_mode")
        # A keyword hit uses keyword grades (0-2); a path-only hit uses path grades
        # (3-7). A non-empty keyword alone does not get extra priority.
        order="ORDER BY rank_grade ASC, score_cur DESC,
               LENGTH(content) ASC, last_access DESC"
        fi
    fi
    # Optional row cap for callers that only need the best match (jump-handler).
    # `mode=last` already carries its own LIMIT.
    if [[ "$mode" != "last" ]] && _is_uint "$limit" && (( $(_dec "$limit") > 0 )); then
        order+=" LIMIT $(_dec "$limit")"
    fi
    local select_sql="SELECT
            keyword,
            printf('%.4f', score_cur),
            CASE
                WHEN keyword = '' THEN printf('%-8.2f', score_cur)
                ELSE keyword || printf('%' || MAX(0, 8 - LENGTH(keyword)) || 's', '')
            END,
            content,
            $grade_expr AS rank_grade
        FROM (SELECT $ENTRY_TABLE.*, $cur AS score_cur${sub_extra} FROM $ENTRY_TABLE)"
    # Output a display column plus the raw path column. fzf shows column 1 and
    # accepts column 2; sqlite mode searches full paths in SQL, so fzf can disable
    # local filtering without losing matching ability.
    local total_sql=""
    if [[ "$total_flag" == "1" ]]; then
        # Consumed by awk and emitted as a trailing TOTAL line; the UI strips it
        # from the candidate list and uses it for the NORMAL-mode prompt.
        total_sql="SELECT 'TOTAL', COUNT(*) FROM $ENTRY_TABLE $where;"$'\n'
    fi
    run_sql "$total_sql$select_sql $where $order" | FRECENCY_QUERY="$([[ "$SEARCH_MODE" == "sqlite" ]] && printf '%s' "$term")" \
        awk -F "$SEP" -v OFS="$SEP" -v max_path_chars="$MAX_PATH_CHARS" -v with_total="$total_flag" '
    BEGIN {
        IGNORECASE = 1
        total = 0
        n = 0
        query = ENVIRON["FRECENCY_QUERY"]
        nwords = split(query, words, /[[:space:]]+/)
        for (wi = 1; wi <= nwords; wi++) {
            if (words[wi] == "") continue
            nchars = split(words[wi], chars, "")
            literal = ""
            for (ci = 1; ci <= nchars; ci++) {
                ch = chars[ci]
                if (index("\\.^$|?*+()[]{}", ch)) literal = literal "\\"
                literal = literal ch
            }
            match_re = match_re (match_re == "" ? "" : "|") literal
        }
        if (match_re != "") match_re = "(" match_re ")"
    }
    $1 == "TOTAL" { total = $2 + 0; next }
    function highlight(value,    rest,out) {
        if (match_re == "") return value
        rest = value
        out = ""
        while (match(rest, match_re)) {
            out = out substr(rest, 1, RSTART - 1) "\033[30;103m" \
                  substr(rest, RSTART, RLENGTH) "\033[0m"
            rest = substr(rest, RSTART + RLENGTH)
        }
        return out rest
    }
    function path_chars(value,    chars,n,i,total) {
        n = split(value, chars, "")
        total = 0
        for (i = 1; i <= n; i++) total += (chars[i] ~ /^[\001-\177]$/ ? 1 : 2)
        return total
    }
    function shorten(path, max,    parts,n,i,last,suffix,marker,marker_width,part_width,available,chars,nchars,out,width) {
        n = split(path, parts, "/")
        marker = ".../"
        last = parts[n]
        suffix = last

        # If the last segment itself is too long, keep its rightmost characters;
        # the path width never exceeds the configured maximum.
        width = path_chars(suffix)
        if (width + path_chars(marker) > max) {
            available = max - path_chars("...")
            if (available < 1) return ""
            nchars = split(suffix, chars, "")
            out = ""
            width = 0
            for (i = nchars; i > 0; i--) {
                part_width = (chars[i] ~ /^[\001-\177]$/ ? 1 : 2)
                if (width + part_width > available) break
                out = chars[i] out
                width += part_width
            }
            return "..." out
        }

        # Consume whole directory segments from the right; never abbreviate the
        # file/directory name itself. Total width stays within max.
        marker_width = path_chars(marker)
        width = marker_width + path_chars(suffix)
        for (i = n - 1; i >= 1; i--) {
            if (parts[i] == "") continue
            part_width = path_chars(parts[i]) + 1
            if (width + part_width > max) break
            suffix = parts[i] "/" suffix
            width += part_width
        }
        return marker suffix
    }
    {
        full = $4
        prefix = $3
        if ($1 != "" && match_re == "") prefix = sprintf("\033[33m%s\033[0m", prefix)
        shown = (path_chars(full) > max_path_chars ? shorten(full, max_path_chars) : full)
        rows[++n] = highlight(prefix "  " shown) OFS full
    }
    END {
        for (i = 1; i <= n; i++) print rows[i]
        if (with_total == 1) printf "TOTAL %d\n", total
    }'
}

_do_internal_op() {
    local op="$1"
    local content="${2##*$SEP}"     # input is the whole row; take the last field
    # Any operation that modifies the stored score (add/del/undo) must go through
    # _ensure_ready: read the marker (one stat) to confirm the schema is ready;
    # if the host SQLite lacks exp(), fail here instead of silently degrading.
    _ensure_ready || return 1
    case "$op" in
        refresh)
            _do_upsert "$content" "" &
            ;;
        del)
            run_sql "
INSERT OR REPLACE INTO $TRASH_TABLE (content, keyword, score)
    SELECT content, keyword, score FROM $ENTRY_TABLE WHERE content = $(sql_lit "$content");
DELETE FROM $ENTRY_TABLE WHERE content = $(sql_lit "$content");" >/dev/null
            ;;
        unbook)
            run_sql "UPDATE $ENTRY_TABLE SET keyword = '' WHERE content = $(sql_lit "$content");" >/dev/null
            ;;
        undo)
            run_sql "
INSERT OR IGNORE INTO $ENTRY_TABLE (content, keyword, score, visits, tick, last_access)
    SELECT content, keyword, score, 1,
           (SELECT CAST(v AS INTEGER) FROM meta WHERE k='$TICK_KEY'), CURRENT_TIMESTAMP
    FROM $TRASH_TABLE ORDER BY deleted_at DESC LIMIT 1;
DELETE FROM $TRASH_TABLE WHERE content =
    (SELECT content FROM $TRASH_TABLE ORDER BY deleted_at DESC LIMIT 1);" >/dev/null
            ;;
    esac
}

do_unbook() {
    local content="$1" changed
    [[ -n "$content" ]] || { printf 'Usage: frecency <topic> unbook <content>\n' >&2; return 2; }
    _ensure_ready || return 1
    changed=$(run_sql "UPDATE $ENTRY_TABLE SET keyword = '' WHERE content = $(sql_lit "$content") AND keyword != ''; SELECT changes();")
    if [[ "$changed" == "1" ]]; then
        printf 'Bookmark removed; EMS history retained: %s\n' "$content"
    else
        printf 'No bookmark found: %s\n' "$content"
    fi
}

do_remove() {
    local route="unified" content="" dest old_table=$ENTRY_TABLE old_trash=$TRASH_TABLE old_tick=$TICK_KEY
    [[ "$TOPIC" == "file_dir" ]] && route="dir"
    [[ "$TOPIC" == "file_file" ]] && route="file"
    while (($#)); do
        case "$1" in
            --route) (($# >= 2)) || return 2; route="$2"; shift 2 ;;
            --route=*) route="${1#*=}"; shift ;;
            *) content="$1"; shift ;;
        esac
    done
    [[ -n "$content" ]] || { printf 'Usage: frecency <topic> remove [--route destinations] <content>\n' >&2; return 2; }
    _ensure_ready || return 1
    local -A seen=()
    IFS=',' read -r -a _route_targets <<< "$route"
    for dest in "${_route_targets[@]}"; do
        case "$dest" in unified|dir|file) ;; *)
            printf 'frecency: invalid --route destination: %s\n' "$dest" >&2
            return 2 ;;
        esac
        [[ -n "${seen[$dest]:-}" ]] && continue
        seen[$dest]=1
        case "$dest" in
            unified) ENTRY_TABLE=entries; TRASH_TABLE=deleted_entries; TICK_KEY=tick ;;
            dir) ENTRY_TABLE=dir_entries; TRASH_TABLE=dir_deleted_entries; TICK_KEY=dir_tick ;;
            file) ENTRY_TABLE=file_entries; TRASH_TABLE=file_deleted_entries; TICK_KEY=file_tick ;;
            *) printf 'frecency: invalid --route destination: %s\n' "$dest" >&2; return 2 ;;
        esac
        if ! _do_internal_op del "$content"; then
            ENTRY_TABLE=$old_table; TRASH_TABLE=$old_trash; TICK_KEY=$old_tick
            return 1
        fi
    done
    ENTRY_TABLE=$old_table; TRASH_TABLE=$old_trash; TICK_KEY=$old_tick
}

# ============================================================================
# UI
# ============================================================================
do_query_ui() {
    _require_fzf
    local search_term="$1"

    local tmux_opt="" border_opt="--border=rounded" _tmux_border_saved=""
    local _fzf_ver
    _fzf_ver=$(fzf --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
    if [[ -n "$TMUX" ]]; then
        local _tmux_ver
        _tmux_ver=$(tmux -V 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)
        if [[ -n "$_tmux_ver" ]] && awk "BEGIN{exit !($_tmux_ver >= 3.3)}" 2>/dev/null; then
            # fzf 0.58+ can keep the popup border native to tmux: tmux draws it
            # around the popup so it survives `v`'s execute handing the popup to
            # the viewer (fzf's own border lives in the alternate screen it
            # leaves). Use a rounded native border to match fzf's look and
            # restore the setting on exit. Older fzf keeps the previous behavior.
            if [[ -n "$_fzf_ver" ]] && (( $(_ver_num "$_fzf_ver") >= $(_ver_num "0.58.0") )); then
                tmux_opt="--tmux 90%,80%,border-native"
                border_opt="--border=none"
                _tmux_border_saved=$(tmux show-options -gv popup-border-lines 2>/dev/null)
                [[ -n "$_tmux_border_saved" ]] && tmux set-option -g popup-border-lines rounded 2>/dev/null
            else
                tmux_opt="--tmux 90%,80%"
            fi
        fi
    fi

    local P_NORMAL="${C_GREEN}${C_BOLD}● NORMAL${C_NORMAL}${C_BOLD} > "
    local P_SEARCH="${C_BLUE}${C_BOLD}● SEARCH${C_NORMAL}${C_BOLD} > "
    # Footer hints are mode-specific. SEARCH keeps only the two ways out plus
    # help; NORMAL lists the actions in priority order. The NORMAL footer is
    # split across two lines because the list pane (with a right preview) is
    # narrower than the full key list. Multi-word SQLite mode adds the
    # ordered/any-order switch hint on its own line.
    local FOOTER_NORMAL_L1="↵ Accept  y Copy  v View  e Edit  g Git"
    local FOOTER_NORMAL_L2="d Del  u Undo  r Unbook  / Search  ? Help  Esc Exit"
    local FOOTER_NORMAL="$FOOTER_NORMAL_L1"$'\n'"$FOOTER_NORMAL_L2"
    local FOOTER_SEARCH="Esc Normal  ? Help"
    local initial_mode="search"
    [[ "$START_MODE" == "normal" ]] && initial_mode="normal"
    local SEARCH_ACTION=enable-search
    local -a FZF_VIEW_OPTS=(--with-nth=1)
    local INITIAL_DATA="$START_DATA" RELOAD_QUERY="all"
    local initial_multiword_mode="${MULTIWORD_MODE:-ordered}"
    [[ "$initial_multiword_mode" == "any-order" ]] || initial_multiword_mode="ordered"
    local _order_file
    _order_file="$(mktemp "${TMPDIR:-/tmp}/frecency_order.XXXXXX")"
    printf '%s\n' "$initial_multiword_mode" > "$_order_file"
    local -a initial_query_words=()
    read -r -a initial_query_words <<< "$search_term"
    local FOOTER_STR
    if [[ "$SEARCH_MODE" == "sqlite" && ${#initial_query_words[@]} -ge 2 ]]; then
        local order_label switch_label
        if [[ "$initial_multiword_mode" == "any-order" ]]; then
            order_label="ANY ORDER"
            switch_label="s→ORDERED"
        else
            order_label="ORDERED"
            switch_label="s→ANY ORDER"
        fi
        if [[ "$initial_mode" == "normal" ]]; then
            FOOTER_STR="$order_label · $switch_label"$'\n'"$FOOTER_NORMAL"
        else
            FOOTER_STR="$order_label · NORMAL $switch_label"
        fi
    elif [[ "$initial_mode" == "normal" ]]; then
        FOOTER_STR="$FOOTER_NORMAL"
    else
        FOOTER_STR="$FOOTER_SEARCH"
    fi
    if [[ "$SEARCH_MODE" == "sqlite" ]]; then
        # SQL reload filters full paths; fzf must not narrow the abbreviated display field.
        SEARCH_ACTION=disable-search
        FZF_VIEW_OPTS+=(--disabled)
        RELOAD_QUERY="all {q}"
        [[ -n "$search_term" ]] && INITIAL_DATA=all
    fi

    local CORE_KEYS=(q j k g y v e d r u x /)
    [[ "$SEARCH_MODE" == "sqlite" ]] && CORE_KEYS+=(s)
    local VIM_NAV
    VIM_NAV=$(IFS=,; echo "${CORE_KEYS[*]}")

    local _mode_file
    _mode_file=$(mktemp "${TMPDIR:-/tmp}/frecency_mode.XXXXXX")
    [[ "$START_MODE" == "normal" ]] && echo "normal" > "$_mode_file" || echo "search" > "$_mode_file"
    local _cand_file
    _cand_file=$(mktemp "${TMPDIR:-/tmp}/frecency_candidates.XXXXXX")
    local _ui_handler="${_mode_file}.ui"
    local _info_handler="${_mode_file}.info"
    local _esc_handler="${_mode_file}.sh"
    local _order_toggle="${_mode_file}.toggle"
    local _copy_footer="${_mode_file}.copyfooter"
    local _git_status="${_mode_file}.gitstatus"
    local _git_abort="${_mode_file}.gitabort"
    # One transform updates both the footer and the NORMAL-mode prompt; it reads
    # the ordered/any-order state, the current mode, and the trailing TOTAL line
    # of the query result so the two displays never disagree.
    local UI_ACTION="transform:$_ui_handler {q} '$_order_file' '$SEARCH_MODE' '$_mode_file' '$FOOTER_NORMAL_L1' '$FOOTER_NORMAL_L2' '$FOOTER_SEARCH'"
    cat > "$_esc_handler" <<ESCSCRIPT
#!/bin/bash
if [ "\$(cat "$_mode_file")" = normal ]; then
    echo abort
else
    echo normal > "$_mode_file"
    echo "disable-search+rebind($VIM_NAV)+$UI_ACTION"
fi
ESCSCRIPT
    chmod +x "$_esc_handler"
    cat > "$_order_toggle" <<'ORDERSCRIPT'
#!/bin/bash
state_file="$1"
IFS= read -r mode < "$state_file" || mode=ordered
if [[ "$mode" == ordered ]]; then
    printf 'any-order\n' > "$state_file"
else
    printf 'ordered\n' > "$state_file"
fi
ORDERSCRIPT
    cat > "$_ui_handler" <<UISCRIPT
#!/bin/bash
query="\$1"
order_file="\$2"
search_mode="\$3"
mode_file="\$4"
normal_l1="\$5"
normal_l2="\$6"
search_footer="\$7"
IFS= read -r order < "\$order_file" || order=ordered
IFS= read -r mode < "\$mode_file" || mode=search
read -r -a words <<< "\$query"
if [[ "\$search_mode" == sqlite && \${#words[@]} -ge 2 ]]; then
    if [[ "\$order" == any-order ]]; then
        order_label="ANY ORDER"
        switch_label="s→ORDERED"
    else
        order_label="ORDERED"
        switch_label="s→ANY ORDER"
    fi
    if [[ "\$mode" == normal ]]; then
        printf -v footer '%s · %s\n%s\n%s' "\$order_label" "\$switch_label" "\$normal_l1" "\$normal_l2"
    else
        printf -v footer '%s · NORMAL %s' "\$order_label" "\$switch_label"
    fi
else
    if [[ "\$mode" == normal ]]; then
        printf -v footer '%s\n%s' "\$normal_l1" "\$normal_l2"
    else
        printf -v footer '%s' "\$search_footer"
    fi
fi
if [[ "\$mode" == normal ]]; then
    printf 'change-footer(%s)+change-prompt($P_NORMAL)' "\$footer"
else
    printf 'change-footer(%s)+change-prompt($P_SEARCH)' "\$footer"
fi
UISCRIPT
    cat > "$_info_handler" <<INFOSCRIPT
#!/bin/bash
# fzf runs this synchronously; use shell builtins only (no extra processes).
cand_file="\$1"
total=0
while IFS= read -r line; do
    case "\$line" in
        TOTAL\ *) total=\${line#TOTAL } ;;
    esac
done < "\$cand_file"
printf '%s/%s' "\${FZF_POS:-1}" "\$total"
INFOSCRIPT
    cat > "$_copy_footer" <<'COPYFOOTER'
#!/bin/bash
# fzf does not expand {} placeholders inside change-footer, so emit the action
# from a transform script. The path is taken verbatim; the whole argument
# inside change-footer(...) is parsed as one string by fzf.
printf 'change-footer(copied %s)' "$1"
COPYFOOTER
    cat > "$_git_abort" <<'GITABORT'
#!/bin/bash
# open_git_repo.sh writes "ok" only when it actually started a git TUI, so
# abort the picker only in that case; an entry outside a repository keeps fzf
# open after the script reports the failure.
if [ "$(cat "$1" 2>/dev/null)" = ok ]; then
    echo abort
else
    echo nop
fi
GITABORT
    chmod +x "$_order_toggle" "$_ui_handler" "$_info_handler" "$_copy_footer" "$_git_abort"
    trap 'rm -f "$_mode_file" "$_esc_handler" "$_order_file" "$_order_toggle" "$_ui_handler" "$_info_handler" "$_copy_footer" "$_git_status" "$_git_abort" "$_cand_file"; [[ -z "$_tmux_border_saved" ]] || tmux set-option -g popup-border-lines "$_tmux_border_saved" 2>/dev/null || true' RETURN

    # All action keys use {2}, the raw path field, and never change the caller's
    # PWD or emit a path. `y` only copies the path and the picker stays (the
    # footer confirms it with the copied path). `v` previews inside the picker
    # under fzf `execute`: fzf is suspended, `view` (or a fallback) owns the
    # popup/terminal, and the picker is restored untouched when the viewer
    # exits — directories open in netrw through the same `view`. In a tmux
    # popup the rounded border is drawn by tmux itself, so it stays visible
    # while the viewer runs (fzf's own border disappears on execute). `e` edits
    # and exits fzf without emitting a path: inside tmux the editor opens in a
    # new fullscreen window and fzf aborts; without tmux the editor runs in the
    # current terminal and fzf aborts when it finishes. `g` hands the selected
    # entry to open_git_repo.sh, which opens the containing repository in the
    # first available gitui/ziggity/lazygit; inside tmux the tool runs in a new
    # window and the picker aborts immediately, without tmux it runs in the
    # current terminal and aborts when it exits. Entries outside a repository
    # leave the picker open.
    # fzf passes execute/reload/preview actions to a shell. Quote SELF with
    # printf %q so an install path containing spaces or metacharacters stays a
    # single command word (plain double quotes would still let a `$` expand).
    local _QSELF _QGIT _QCAND
    _QSELF=$(printf '%q' "$SELF")
    _QGIT=$(printf '%q' "$SCRIPT_DIR/open_git_repo.sh")
    _QCAND=$(printf '%q' "$_cand_file")
    local -a ACTION_KEY_BINDS=(
        --bind "y:execute-silent($_QSELF \"$TOPIC\" fzf-action copy {2})+transform:$_copy_footer {2}"
        --bind "v:execute($_QSELF \"$TOPIC\" fzf-action view {2})"
        --bind "g:execute($_QGIT {2} '$_git_status')+transform:$_git_abort '$_git_status'"
    )
    if [[ -n "$TMUX" ]]; then
        ACTION_KEY_BINDS+=(
            --bind "e:execute($_QSELF \"$TOPIC\" fzf-action edit-stay {2})+abort"
        )
    else
        ACTION_KEY_BINDS+=(
            --bind "e:execute($_QSELF \"$TOPIC\" fzf-action edit {2})+abort"
        )
    fi

    local SET_SEARCH="execute-silent(echo search > '$_mode_file')"
    local SET_NORMAL="execute-silent(echo normal > '$_mode_file')"

    # START_BIND sets the initial mode only. The initial --footer is already
    # correct for START_MODE and the initial query; do not transform it from
    # start, where {q} can still be empty and would overwrite a multi-word hint.
    local START_BIND="start:$SEARCH_ACTION+unbind($VIM_NAV)+change-prompt($P_SEARCH)+$SET_SEARCH+$UI_ACTION"
    [[ "$START_MODE" == "normal" ]] && START_BIND="start:disable-search+change-prompt($P_NORMAL)+$SET_NORMAL+$UI_ACTION"

    local SEARCH_BIND="$SEARCH_ACTION+unbind($VIM_NAV)+change-prompt($P_SEARCH)+$SET_SEARCH+$UI_ACTION"
    [[ "$START_DATA" == "last" ]] && SEARCH_BIND="$SEARCH_BIND+transform:test -z '{q}' && echo 'execute-silent($_QSELF \"$TOPIC\" internal-query all $QUERY_LIMIT 1 > $_QCAND || true)+reload(sed '\$d' $_QCAND)' || echo 'nop'"

    local CHANGE_BIND="first"
    # fzf cancels the previous reload when a new one starts, so a short debounce
    # keeps fast typing from piling up queries without adding a fixed 60 ms tax
    # to every keystroke. The query writes candidates plus a trailing TOTAL line
    # into one file synchronously (execute-silent); reload strips that line and
    # the prompt transform reads it, so both stay fresh without a second file.
    if [[ "$SEARCH_MODE" == "sqlite" ]]; then
        CHANGE_BIND="execute-silent(sleep $SLEEP_DELAY; $_QSELF \"$TOPIC\" internal-query all {q} $QUERY_LIMIT 1 > $_QCAND || true)+reload(sed '\$d' $_QCAND)+$CHANGE_BIND"
    fi
    CHANGE_BIND+="+$UI_ACTION"

    local RELOAD_AND_FILTER="execute-silent($_QSELF \"$TOPIC\" internal-query $RELOAD_QUERY $QUERY_LIMIT 1 > $_QCAND || true)+reload(sed '\$d' $_QCAND)+$SEARCH_ACTION+$SET_SEARCH+$UI_ACTION"

    local -a ORDER_MODE_BIND=()
    if [[ "$SEARCH_MODE" == "sqlite" ]]; then
        ORDER_MODE_BIND+=(--bind "s:execute-silent($_order_toggle '$_order_file')+execute-silent($_QSELF \"$TOPIC\" internal-query all {q} $QUERY_LIMIT 1 > $_QCAND || true)+reload(sed '\$d' $_QCAND)+$UI_ACTION")
    fi

    # fzf >= 0.54 can customize the info line; older versions keep the native
    # counter (which only knows the capped 32 candidates).
    local -a _info_opts=(--info=inline)
    if [[ -n "$_fzf_ver" ]] && (( $(_ver_num "$_fzf_ver") >= $(_ver_num "0.54.0") )); then
        _info_opts+=(--info-command="$_info_handler '$_cand_file'")
    fi

    # Keep only one fzf invocation: the two TERM branches had identical flags/bind,
    # and duplicated maintenance already caused one missed change (accept-nth).
    # Highlighting happens at the internal-query source and goes straight into fzf.
    FRECENCY_ORDER_FILE="$_order_file" \
        "$SELF" "$TOPIC" internal-query "$INITIAL_DATA" "$search_term" "$QUERY_LIMIT" 1 > "$_cand_file"
    FRECENCY_ORDER_FILE="$_order_file" fzf < "$_cand_file" \
            --ansi --query "$search_term" --footer "$FOOTER_STR" \
            --layout=reverse --tiebreak='index' --no-sort $tmux_opt \
            --preview-window=right:50% $border_opt "${_info_opts[@]}" \
            --delimiter="$SEP" --accept-nth='2' "${FZF_VIEW_OPTS[@]}" --literal --exact \
            --bind "$START_BIND" --bind "change:$CHANGE_BIND" --bind "/:$SEARCH_BIND" \
            --bind "x:$SEARCH_ACTION+clear-query+$SET_SEARCH+$UI_ACTION" \
            --bind "esc:transform:$_esc_handler" \
            --bind "j:down,k:up,q:abort" \
            --bind "d:execute-silent($_QSELF \"$TOPIC\" internal-op del {})+$RELOAD_AND_FILTER" \
            --bind "r:execute-silent($_QSELF \"$TOPIC\" internal-op unbook {})+$RELOAD_AND_FILTER" \
            --bind "u:execute-silent($_QSELF \"$TOPIC\" internal-op undo)+$RELOAD_AND_FILTER" \
            --bind "?:execute($_QSELF \"$TOPIC\" fzf-action help)" \
            "${ACTION_KEY_BINDS[@]}" \
            "${ORDER_MODE_BIND[@]}" \
            --preview "$_QSELF \"$TOPIC\" preview {}"
}

# ============================================================================
# Jump / output for the caller to execute
# ============================================================================
# Pick the viewer for NORMAL-mode `v`. `view` (vim read-only) is preferred:
# it gives syntax highlighting and normal-mode navigation. FRECENCY_VIEWER can
# override the first choice; otherwise the chain degrades to $PAGER, less, cat.
_frecency_viewer_cmd() {
    local candidate
    if [[ -n "${FRECENCY_VIEWER:-}" ]]; then
        candidate="${FRECENCY_VIEWER%% *}"
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s' "$FRECENCY_VIEWER"
            return 0
        fi
    fi
    if command -v view >/dev/null 2>&1; then
        printf 'view'
        return 0
    fi
    if [[ -n "${PAGER:-}" ]]; then
        candidate="${PAGER%% *}"
        if command -v "$candidate" >/dev/null 2>&1; then
            printf '%s' "$PAGER"
            return 0
        fi
    fi
    if command -v less >/dev/null 2>&1; then
        printf 'less -R'
        return 0
    fi
    printf 'cat'
}

# NORMAL-mode helpers driven by fzf key binds. `copy` puts the raw path on the
# clipboard without a trailing newline. `edit`/`view` run in the foreground
# under fzf `execute`, which suspends fzf so the program owns the popup or the
# terminal and renders normally; the picker is restored untouched afterwards.
# Directories open through `view` (netrw) with the same viewer chain. The
# `edit-stay` variant opens the editor in a tmux window instead of inside the
# popup, so `e` can hand over to a fullscreen editor and abort. Every variant
# leaves the shell's PWD alone.
do_fzf_action() {
    local mode="$1" path="$2" foreground cmd pager
    case "$mode" in
        copy)
            if command -v wl-copy >/dev/null 2>&1; then
                printf '%s' "$path" | wl-copy
            elif command -v xclip >/dev/null 2>&1; then
                printf '%s' "$path" | xclip -selection clipboard
            fi
            return 0
            ;;
        help)
            # Show the full key map in the user's pager; fzf's execute action
            # suspends the picker so this owns the terminal/popup until q.
            # PAGER=cat is common but would just flash the text, so prefer less
            # for this interactive screen when available.
            pager="${PAGER:-less -R}"
            case "${pager%% *}" in cat) pager="less -R" ;; esac
            command -v "${pager%% *}" >/dev/null 2>&1 || pager="cat"
            cat <<'EOF' | $pager
? Help - Full Keybindings

NORMAL mode:
  ↵ Enter     - Accept selection (jump to directory / copy file path)
  y           - Copy path to clipboard (footer confirms)
  v           - Preview file (view/netrw/less/cat), q to return
  e           - Edit with $EDITOR (opens in new tmux window if in tmux)
  g           - Open the containing git repository in gitui/ziggity/lazygit and exit
  d           - Delete entry (moves to trash, undoable with u)
  r           - Remove bookmark (keep EMS history)
  u           - Undo last delete
  /           - Enter SEARCH mode
  s           - Toggle ordered/any-order multi-word matching
  x           - Clear query
  j/k         - Vim navigation (down/up)
  ?           - Show this help
  Esc         - Exit fzf
  q           - Quit (NORMAL mode)

SEARCH mode:
  /           - (already in search)
  Esc         - Return to NORMAL mode
  ?           - Show this help

Press q to close this help
EOF
            return 0
            ;;
        edit-stay)
            foreground=edit
            if [[ -n "$TMUX" ]]; then
                tmux new-window "EDITOR=$(printf '%q' "${EDITOR:-vi}") PAGER=$(printf '%q' "${PAGER:-less -R}") FRECENCY_VIEWER=$(printf '%q' "${FRECENCY_VIEWER:-}") $(printf '%q' "$SELF") $(printf '%q' "$TOPIC") fzf-action $(printf '%q' "$foreground") $(printf '%q' "$path")" >/dev/null 2>&1
                return 0
            fi
            ;;
        edit|view)
            foreground=$mode
            ;;
        *) return 2 ;;
    esac
    if [[ "$foreground" == "edit" ]]; then
        cmd="${EDITOR:-vi}"
    elif [[ -d "$path" ]]; then
        # `view` on a directory opens the netrw browser: interactive listing,
        # enter subdirectories, `q` returns to the picker.
        cmd="view"
        command -v view >/dev/null 2>&1 || cmd="eza -la"
        command -v view >/dev/null 2>&1 || command -v eza >/dev/null 2>&1 || cmd="ls -la"
    else
        cmd=$(_frecency_viewer_cmd)
    fi
    eval "$cmd $(printf '%q' "$path")"
}

# Backward-compatible name for external callers of the previous UI action.
do_open_external() { do_fzf_action "$1" "$2"; }

do_jump_handler() {
    local picker=0 emit=shell term="" arg res
    for arg in "$@"; do
        case "$arg" in
            --picker) picker=1 ;;
            --emit=path) emit=path ;;
            --emit=shell) emit=shell ;;
            *) term+="${term:+ }$arg" ;;
        esac
    done

    if (( picker )); then
        # Interactive picker; an optional term becomes the initial fzf query.
        # Call the UI function directly: command substitution still forks, but
        # it no longer re-executes and re-parses this whole script.
        res=$(do_query_ui "$term") || exit 0
        [[ -z "$res" ]] && exit 0
    elif [[ -n "$term" ]]; then
        # zoxide / ze semantics: with a query, skip fzf and take the best entry by
        # EMS + match grade (first internal-query row = highest grade, then highest
        # score_cur within that grade). The row cap keeps formatting O(1).
        res=$(_do_internal_query all "$term" 1)
        if [[ -z "$res" ]]; then
            # The shell integrations pre-check `-` and existing paths, so a
            # non-empty term that reaches here matched nothing. Report it instead
            # of exiting silently: aliasing cd to `j` expects cd-style failure.
            case "$TOPIC" in
                file|file_dir|file_file)
                    if [[ "$ACTION" != *"vifm" ]]; then
                        printf 'frecency: no history match for: %s\n' "$term" >&2
                        exit 1
                    fi
                    ;;
            esac
            exit 0
        fi
    else
        res=$(do_query_ui) || exit 0
        [[ -z "$res" ]] && exit 0
    fi
    local raw_path="${res##*$SEP}"

    if [[ "$emit" == "path" && "$ACTION" != *"vifm" ]]; then
        case "$TOPIC" in
            file_dir)
                [[ -d "$raw_path" ]] || { printf 'frecency: directory path not on disk: %s\n' "$raw_path" >&2; exit 1; }
                printf '%s\n' "$raw_path"; exit 0
                ;;
            file_file)
                [[ -f "$raw_path" ]] || { printf 'frecency: file path not on disk: %s\n' "$raw_path" >&2; exit 1; }
                printf '%s\n' "$raw_path"; exit 0
                ;;
            file)
                [[ -e "$raw_path" ]] || { printf 'frecency: path not on disk: %s\n' "$raw_path" >&2; exit 1; }
                printf '%s\n' "$raw_path"; exit 0
                ;;
        esac
    fi

    if [[ "$TOPIC" == "cmd" ]]; then printf '%s\n' "$raw_path"; exit 0; fi

    if [[ "$TOPIC" == "file_dir" ]]; then
        [[ -d "$raw_path" ]] || { printf 'frecency: directory path not on disk: %s\n' "$raw_path" >&2; exit 1; }
        printf "cd '%s'\n" "$(shq "$raw_path")"
    elif [[ "$TOPIC" == "file_file" ]]; then
        [[ -f "$raw_path" ]] || { printf 'frecency: file path not on disk: %s\n' "$raw_path" >&2; exit 1; }
        if [[ "$ACTION" == *"vifm" ]]; then
            printf "goto '%s'\n" "$(shq "$raw_path")"
        else
            if [[ "$XDG_SESSION_TYPE" == "wayland" ]] && command -v wl-copy >/dev/null; then
                printf '%s' "$raw_path" | wl-copy
            elif command -v xclip >/dev/null; then
                printf '%s' "$raw_path" | xclip -selection clipboard
            fi
            printf "cd '%s'; printf '%%s\\n' '%s'\n" \
                "$(shq "$(dirname "$raw_path")")" "$(shq "Copied path: $raw_path")"
        fi
    elif [[ -d "$raw_path" ]]; then
        printf "cd '%s'\n" "$(shq "$raw_path")"
    elif [[ -f "$raw_path" ]]; then
        # Selection itself is not a visit (no score bump here): navigating to
        # a file only positions on it. A visit is counted when the file is
        # actually opened (vifm l/<CR> trackFile, Neovim BufRead, ...).
        if [[ "$ACTION" == *"vifm" ]]; then
            printf "goto '%s'\n" "$(shq "$raw_path")"
        else
            if [[ "$XDG_SESSION_TYPE" == "wayland" ]] && command -v wl-copy >/dev/null; then
                printf '%s' "$raw_path" | wl-copy
            elif command -v xclip >/dev/null; then
                printf '%s' "$raw_path" | xclip -selection clipboard
            fi
            printf "cd '%s'; printf '%%s\\n' '%s'\n" \
                "$(shq "$(dirname "$raw_path")")" "$(shq "Copied path: $raw_path")"
        fi
    else
        if [[ "$TOPIC" == "dir" || "$TOPIC" == file* ]]; then
            printf '%sError:%s Path not on disk: %s\n' "$C_YELLOW" "$C_NORMAL" "$raw_path" >&2
            exit 1
        else
            printf '%s\n' "$raw_path"
        fi
    fi
}

# ============================================================================
# Main router (topics may be comma-separated to write multiple DBs at once)
# ============================================================================
_require_sqlite3

IFS=',' read -r -a TOPICS <<< "$TOPIC"

for _T in "${TOPICS[@]}"; do
    case "$_T" in
        file|file_dir|file_file) export DB_PATH="$DATA_DIR/file.db" ;;
        *)                       export DB_PATH="$DATA_DIR/${_T}.db" ;;
    esac
    export CONFIG_PATH="$DATA_DIR/${_T}.config"
    export MARKER="$DATA_DIR/.${_T}.v4"
    # Lock by database file, not by topic: file/file_dir/file_file share file.db,
    # so they must serialize first-time migration on the same lock.
    LOCK_FILE="$DATA_DIR/.$(basename "$DB_PATH").init.lock"
    export LOCK_FILE

    case "$_T" in
        file_dir) ENTRY_TABLE=dir_entries; TRASH_TABLE=dir_deleted_entries; TICK_KEY=dir_tick ;;
        file_file) ENTRY_TABLE=file_entries; TRASH_TABLE=file_deleted_entries; TICK_KEY=file_tick ;;
        *) ENTRY_TABLE=entries; TRASH_TABLE=deleted_entries; TICK_KEY=tick ;;
    esac

    # Default decay constant per logical topic: the unified `file` table pools
    # directory visits and file opens, so its event clock sees roughly twice
    # the events of a split table; halve LAMBDA to keep a similar wall-clock
    # decay. Topic config files still override any default.
    case "$_T" in
        file) _lambda_default=0.005 ;;
        *)    _lambda_default=0.01 ;;
    esac
    LAMBDA=$_lambda_default

    # Per-topic configuration overrides
    MAX_ENTRIES=
    MAX_ENTRIES_UNIFIED=
    MAX_ENTRIES_DIR=
    MAX_ENTRIES_FILE=
    QUERY_LIMIT=32
    PRUNE_FILL_PERCENT=
    _PRUNE_FILL_PERCENT=
    _SHARED_LIMITS_LOADED=0
    if [[ -f "$CONFIG_PATH" ]]; then
        # A config may accidentally change IFS, which would corrupt every later
        # `read -a` word split (multi-word matching, grading, footer). Keep the
        # shell's word-splitting stable regardless of config contents.
        _saved_ifs="$IFS"
        # shellcheck disable=SC1090  # CONFIG_PATH is the per-topic user config
        source "$CONFIG_PATH"
        IFS="$_saved_ifs"
        # Validate numeric config before it reaches SQL or shell command strings.
        # PRUNE_FILL_PERCENT is normalized by _prune_fill_percent() at use time.
        _is_num "$LAMBDA" || LAMBDA=$_lambda_default
        _is_num "$SLEEP_DELAY" || SLEEP_DELAY=0.02
        _is_uint "$UNDO_KEEP" || UNDO_KEEP=200
        _is_uint "$QUERY_LIMIT" || QUERY_LIMIT=32
        _is_uint "$LAST_LIMIT" || LAST_LIMIT=15
        _is_uint "$MAX_PATH_CHARS" || MAX_PATH_CHARS=60
    fi

    if [[ "$LAMBDA" == "$_lambda_default" ]]; then
        # No explicit override: keep the per-destination defaults so a mixed
        # `--route unified,dir` / `--route unified,file` write decays the
        # unified and split tables at their own rates.
        if [[ "$DB_PATH" == "$DATA_DIR/file.db" ]]; then
            _LAMBDA_UNIFIED=0.005
        else
            _LAMBDA_UNIFIED=0.01
        fi
        _LAMBDA_DIR=0.01
        _LAMBDA_FILE=0.01
    else
        # An explicit LAMBDA in the topic config applies to every destination
        # written by this invocation.
        _LAMBDA_UNIFIED=$LAMBDA
        _LAMBDA_DIR=$LAMBDA
        _LAMBDA_FILE=$LAMBDA
    fi

    case "$ACTION" in
        init)           _initialize 1 ;;
        cleanup)        do_cleanup ;;
        add)            do_add "$@" ;;
        unbook)         do_unbook "$1" ;;
        remove)         do_remove "$@" ;;
        recent)         do_recent "$1" "$2" ;;
        query)          do_query_ui "$1" ;;
        preview)        do_preview "$1" ;;
        fzf-action)     do_fzf_action "$1" "$2" ;;
        open-external)  do_open_external "$1" "$2" ;;
        jump-handler*)  do_jump_handler "$@" ;;
        internal-query) _do_internal_query "$@" ;;
        internal-op)    _do_internal_op "$1" "$2" ;;
        *)              printf 'Unknown action: %s\n' "$ACTION"; exit 1 ;;
    esac
done
