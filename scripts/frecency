#!/bin/bash
# ============================================================================
# frecency - navigation/history entry manager with time decay (SQLite + fzf)
# ============================================================================
# Features:
#   - Multiple topics: dir / file / cmd / any custom topic, each with its own DB
#   - True frecency: event clock + exponential moving sum (EMS); decay on write,
#     alignment on read
#   - Keywords (bookmarks): fast lookup and highlighting; a bookmark can be
#     removed while keeping its EMS history
#   - Modal fzf UI (NORMAL / SEARCH), smart preview, manual curation (delete/undo)
#   - Two search modes (SEARCH_MODE), see "Default configuration" below:
#       sqlite (default)  query the DB on every keystroke -> ordered/any-order
#                         multi-word matching + match-quality grading
#       fzf               load everything up front -> zero-latency filtering of
#                         the abbreviated display column
#   - Match-quality grading can be disabled with GRADE_MODE=off (rank by EMS)
#
# Ranking model (v3): decay on write, align on read
#   write: score = score * exp(-LAMBDA * Δticks) + 1
#   read:  current = score * exp(-LAMBDA * (T_now - tick))
#   where Δticks = global event-clock delta (one tick per add; idle costs none).
#   score only changes when the entry itself is visited, so it is only valid for
#   the tick at that moment; different entries hold scores at different ticks and
#   cannot be compared directly. Sorting / cleanup / display always use current,
#   aligning every entry to the same moment.
#   Half-life = ln(2)/LAMBDA visits. LAMBDA=0.01 -> about 69 visits.
#   This prevents old entries from dominating forever and avoids losing all
#   history after a long break.
#
# Usage:
#    frecency <topic> init                     : initialize/migrate the database
#    frecency <topic> add <content> [keyword]  : record an entry (topic may be a
#                                                comma-separated list)
#    frecency <topic> unbook <content>         : remove bookmark, keep EMS history
#    frecency <topic> query [search_term]      : open the fzf UI
#    frecency <topic> jump-handler [term]      : shell / vifm integration
#    frecency <topic> remove <content>         : delete an entry (undoable)
#    frecency <topic> recent <seconds>         : exit 0 if any entry was updated
#                                                within the last N seconds
#    frecency <topic> cleanup                  : manual maintenance
#
# The generic interface accepts comma-separated topics; the Vifm/Fish/Neovim
# integration uses `file` for both directories and files:
#    frecency topic-a,topic-b add /path/to/x
#
# Dependencies:
#    - Core: bash (4.4+), sqlite3 (>=3.35.0 with exp()), fzf (>=0.35.0), file,
#      coreutils, flock
#    - Optional: eza (directory preview), bat / highlight (syntax highlighting)
#    - Deployment self-check: frecency-test (writes the sqlite3 selection cache)
# ============================================================================

# Only supply a UTF-8 locale when the user has none configured at all; never
# override an existing LANG/LC_ALL (LC_ALL wins over every other variable and
# would also leak into child tools like fzf/eza/bat, changing their message
# language and sort order). C.UTF-8 ships with glibc and musl, unlike
# en_US.UTF-8 which may not be generated on minimal/container systems.
if [[ -z ${LC_ALL:-} && -z ${LANG:-} ]]; then
    export LC_ALL=C.UTF-8
fi

# Field separator: ASCII UNIT SEPARATOR. It practically never appears in paths,
# avoiding the old \t problem where a TAB in a path truncated the entry.
SEP=$'\x1f'

SCHEMA_VERSION=3

# --- Paths and Identity ---
DATA_DIR="$HOME/.local/share/frecency"
mkdir -p "$DATA_DIR"
SELF=$(readlink -f "$0")
SCRIPT_DIR=$(dirname "$SELF")
TOPIC="${1:-default}"
ACTION="$2"
[ -n "$ACTION" ] && shift 2

# --- Architecture detection (must match frecency-test) ---
_sqlite_arch=""
case "$(uname -m)" in
    x86_64|amd64)  _sqlite_arch="x86_64" ;;
    aarch64|arm64) _sqlite_arch="arm64" ;;
esac

# --- Default configuration (overridable by <topic>.config) ---
MAX_ENTRIES=10000
MAX_DAYS=300
SLEEP_DELAY=0.06    # reload debounce for sqlite mode; a query takes ~25ms, so 0.2 is pure lag
START_DATA=all      # 'last' recent entries / 'all' everything
START_MODE=search   # 'normal' (Vim keys) / 'search' (type directly)
LAST_LIMIT=15
MAX_PATH_CHARS=60  # display width (ASCII 1, non-ASCII 2); abbreviate only beyond this
# Search modes (both are kept; switch per topic in <topic>.config):
#   sqlite  queries the DB on every keystroke. In exchange it knows the query and can:
#             · match multi-word queries in order (default) or any order (press s)
#             · grade match quality: keyword hits use keyword grades; path hits use
#               path grades
#   fzf     loads everything into memory at start: zero keystroke latency and no
#             reload debounce, but cannot match hidden middle path segments and does
#             not do query-aware grading.
SEARCH_MODE=sqlite
# Match-quality grading (only in SEARCH_MODE=sqlite and with a query):
#   on   (default) hard grade by keyword/path hit quality, EMS within each grade;
#        lifts exact basename matches among ordinary history entries
#   off  skip grading; every match is ordered by score_cur (multi-word filtering
#        still applies). This is jghub's stance (fzf#4789): grading is a hard-coded
#        preference that can override real usage history.
GRADE_MODE=on
MULTIWORD_MODE=ordered # ordered (default) or any-order; toggled with s in sqlite UI
LAMBDA=0.01         # decay constant (per visit); half-life = ln2/LAMBDA
UNDO_KEEP=200       # number of deleted_entries kept
IGNORE_PATTERNS=(
    "*/fuse"        # FUSE mount point
    "*/fuse/*"      # files inside FUSE mounts
    "*/.git"        # Git metadata
    "*/.git/*"
    "*/tmp/*"       # temporary files
)

# --- ANSI colors ---
C_NORMAL=$'\e[0m'
C_BOLD=$'\e[1m'
C_GREEN=$'\e[32m'
C_CYAN=$'\e[36m'
C_BLUE=$'\e[34m'
C_YELLOW=$'\e[33m'

# ============================================================================
# sqlite3 selection: cache > system (adequate version) > bundled static binary
# ============================================================================
# The bundled static binary is a fallback for machines without sqlite3. On a
# machine with a system sqlite3 it is actually slower (40ms vs 3ms startup in
# testing), so the system version wins by default. The choice is cached in
# $DATA_DIR/.sqlite3.bin: probe only when the cache is missing, then zero cost.
# frecency-test rewrites this cache.
_SQLITE_MIN=3035000   # 3.35.0 (minimum for exp(); runtime probe covers build flags)
_FZF_MIN="0.48.0"     # minimum for --accept-nth / change-footer / rebind / --tmux
SQLITE3=""

_ver_num() { awk -F. '{printf "%d", ($1*1000000)+($2*1000)+$3}' <<< "$1"; }

_sqlite_ok() {
    local b="$1" v
    v=$("$b" --version 2>/dev/null | awk '{print $1}') || return 1
    [[ -n "$v" ]] || return 1
    [[ $(_ver_num "$v") -ge $_SQLITE_MIN ]]
}

_resolve_sqlite3() {
    local cache="$DATA_DIR/.sqlite3.bin" p
    if [[ -s "$cache" ]]; then
        p=$(<"$cache")
        if [[ -n "$p" && ( -x "$p" || -n "$(command -v "$p" 2>/dev/null)" ) ]]; then
            SQLITE3="$p"; return 0
        fi
    fi
    local sys bundled
    sys=$(command -v sqlite3 2>/dev/null)
    bundled=""
    if [[ -n "$_sqlite_arch" ]]; then
        # Repo layout is bundled/sqlite3-<arch>; the installer flattens it to
        # sqlite3-<arch> inside the vifm scripts directory.
        bundled="$SCRIPT_DIR/sqlite3-$_sqlite_arch"
        [[ -x "$bundled" ]] || bundled="$SCRIPT_DIR/../bundled/sqlite3-$_sqlite_arch"
    fi
    if [[ -n "$sys" ]] && _sqlite_ok "$sys"; then
        SQLITE3="$sys"
    elif [[ -n "$bundled" && -x "$bundled" ]] && _sqlite_ok "$bundled"; then
        SQLITE3="$bundled"
    else
        SQLITE3="${sys:-${bundled:-sqlite3}}"
    fi
    printf '%s' "$SQLITE3" > "$cache" 2>/dev/null
}
_resolve_sqlite3

# ============================================================================
# SQL helpers
# ============================================================================
# Convert any value into a safe SQL string literal (' -> '').
# This is the only correct escaping method; the old .parameter + double-quote
# approach was text interpolation and silently swallowed backslashes, failed on
# double quotes, and broke the statement on newlines.
sql_lit() { local s=${1//\'/\'\'}; printf "'%s'" "$s"; }

# Escape ! / % / _ when building LIKE patterns, and use ESCAPE '!' with them;
# otherwise user-supplied % / _ are treated as wildcards.
sql_like() {
    local s=${1//!/!!}
    s=${s//%/!%}
    s=${s//_/!_}
    sql_lit "%$s%"
}

sql_like_prefix() {
    local s=${1//!/!!}
    s=${s//%/!%}
    s=${s//_/!_}
    sql_lit "$s%"
}

sql_like_segment_prefix() {
    local s=${1//!/!!}
    s=${s//%/!%}
    s=${s//_/!_}
    sql_lit "%/$s%"
}

# Combine a multi-word query into an ordered LIKE pattern, e.g.
# "foo bar" -> "%foo%bar%". LIKE wildcards inside each word are still escaped
# literally; the % between words is the ordered gap.
sql_like_ordered() {
    local -a words=()
    read -r -a words <<< "$1"
    local pattern="" word escaped
    for word in "${words[@]}"; do
        escaped=${word//!/!!}
        escaped=${escaped//%/!%}
        escaped=${escaped//_/!_}
        [[ -n "$pattern" ]] && pattern+="%"
        pattern+="$escaped"
    done
    sql_lit "%$pattern%"
}

sql_like_ordered_prefix() {
    local -a words=()
    read -r -a words <<< "$1"
    local pattern="" word escaped
    for word in "${words[@]}"; do
        escaped=${word//!/!!}
        escaped=${escaped//%/!%}
        escaped=${escaped//_/!_}
        [[ -n "$pattern" ]] && pattern+="%"
        pattern+="$escaped"
    done
    sql_lit "$pattern%"
}

_all_words_like_expr() {
    local column="$1" expression="" word
    shift
    for word in "$@"; do
        [[ -n "$expression" ]] && expression+=" AND "
        expression+="$column LIKE $(sql_like "$word") ESCAPE '!'"
    done
    printf '(%s)' "$expression"
}

# Query grade: shared by list ordering and preview to avoid logic drift.
_query_grade_expr() {
    local term="$1" last_word="$2" mode="${3:-ordered}"
    local -a words=()
    read -r -a words <<< "$term"
    local full prefix contains lw lw_prefix lw_contains path_prefix hidden_prefix
    full=$(sql_lit "$term")
    if [[ "$mode" == "ordered" ]]; then
        prefix=$(sql_like_ordered_prefix "$term")
        contains=$(sql_like_ordered "$term")
    else
        local first_prefix rest_matches
        first_prefix="keyword LIKE $(sql_like_prefix "${words[0]}") ESCAPE '!'"
        rest_matches=$(_all_words_like_expr keyword "${words[@]:1}")
        [[ -n "${words[*]:1}" ]] && prefix="($first_prefix AND $rest_matches)" \
            || prefix="($first_prefix)"
        contains=$(_all_words_like_expr keyword "${words[@]}")
    fi
    lw=$(sql_lit "$last_word")
    lw_prefix=$(sql_like_prefix "$last_word")
    lw_contains=$(sql_like "$last_word")
    path_prefix=$(sql_like_segment_prefix "$last_word")
    hidden_prefix=$(sql_like_segment_prefix ".$last_word")
    if [[ "$mode" == "ordered" ]]; then
        printf "(CASE
        WHEN keyword = %s THEN 0
        WHEN keyword LIKE %s ESCAPE '!' THEN 1
        WHEN keyword LIKE %s ESCAPE '!' THEN 2
        WHEN last_seg = %s THEN 3
        WHEN last_seg LIKE %s ESCAPE '!' THEN 4
        WHEN last_seg LIKE %s ESCAPE '!' THEN 5
        WHEN content LIKE %s ESCAPE '!' OR content LIKE %s ESCAPE '!' THEN 6
        ELSE 7 END)" \
            "$full" "$prefix" "$contains" "$lw" "$lw_prefix" "$lw_contains" "$path_prefix" "$hidden_prefix"
    else
        printf "(CASE
        WHEN keyword = %s THEN 0
        WHEN %s THEN 1
        WHEN %s THEN 2
        WHEN last_seg = %s THEN 3
        WHEN last_seg LIKE %s ESCAPE '!' THEN 4
        WHEN last_seg LIKE %s ESCAPE '!' THEN 5
        WHEN content LIKE %s ESCAPE '!' OR content LIKE %s ESCAPE '!' THEN 6
        ELSE 7 END)" \
            "$full" "$prefix" "$contains" "$lw" "$lw_prefix" "$lw_contains" "$path_prefix" "$hidden_prefix"
    fi
}

_current_multiword_mode() {
    local mode="${MULTIWORD_MODE:-ordered}"
    if [[ -n "${FRECENCY_ORDER_FILE:-}" && -r "$FRECENCY_ORDER_FILE" ]]; then
        IFS= read -r mode < "$FRECENCY_ORDER_FILE" || true
    fi
    [[ "$mode" == "any-order" ]] || mode="ordered"
    printf '%s' "$mode"
}

# Pass SQL through stdin so heredoc shell expansion cannot interfere.
run_sql() {
    { printf '%s\n' ".timeout 5000"; printf '%s\n' "$1"; } \
        | "$SQLITE3" -batch -bail -list -separator "$SEP" -init /dev/null "$DB_PATH"
}

# Safely wrap any string in single quotes (for generated cd / goto commands).
shq() { local s=${1//\'/\'\\\'\'}; printf '%s' "$s"; }

_require_sqlite3() {
    if [[ ! -x "$SQLITE3" ]] && ! command -v "$SQLITE3" >/dev/null 2>&1; then
        printf 'frecency: no usable sqlite3 found (%s)\n' "$SQLITE3" >&2
        exit 127
    fi
}
_require_fzf() {
    if ! command -v fzf >/dev/null 2>&1; then
        printf 'frecency: fzf not found\n' >&2
        exit 127
    fi
    # Version gate: requires 0.48+ features (--accept-nth / change-footer / rebind / --tmux).
    local v; v=$(fzf --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1)
    if [[ -n "$v" ]] && (( $(_ver_num "$v") < $(_ver_num "$FZF_MIN_VER") )); then
        printf 'frecency: fzf %s is too old; need >= %s (--accept-nth / change-footer / rebind)\n' \
            "$v" "$FZF_MIN_VER" >&2
        exit 127
    fi
}

# ============================================================================
# Database
# ============================================================================
do_init() {
    # Remember the pre-migration version: v2 -> v3 must reset scores polluted by
    # PIN_BASE. On a fresh database this is empty (SELECT fails without a meta table).
    local prev=""
    prev=$(run_sql "SELECT v FROM meta WHERE k = 'schema_version';" 2>/dev/null) || prev=""
    # Order matters: create tables and migrate (ALTER ADD COLUMN) first, then indexes.
    # --- Step 1: tables / trash / meta (no indexes) ---
    run_sql "
PRAGMA journal_mode = WAL;
PRAGMA synchronous = NORMAL;
PRAGMA cache_size = -2000;

CREATE TABLE IF NOT EXISTS entries (
    content TEXT PRIMARY KEY,
    keyword TEXT DEFAULT '',
    score REAL DEFAULT 1.0,
    visits INTEGER DEFAULT 1,
    tick INTEGER DEFAULT 0,
    last_access DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS deleted_entries (
    content TEXT PRIMARY KEY,
    keyword TEXT,
    score REAL,
    deleted_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE IF NOT EXISTS meta (k TEXT PRIMARY KEY, v TEXT);

INSERT OR IGNORE INTO meta VALUES ('schema_version','$SCHEMA_VERSION'), ('tick','0');
" >/dev/null 2>&1 || {
        printf 'frecency: failed to create base database schema: %s\n' "$DB_PATH" >&2
        return 1
    }

    # --- Step 2: v1 -> v2 migration; ALTER only missing columns ---
    # Check columns before ALTER to stay idempotent; -bail stops on the first error.
    local have alters=""
    have=$(run_sql "SELECT group_concat(name) FROM pragma_table_info('entries')
                    WHERE name IN ('visits','tick');") || {
        printf 'frecency: cannot read database columns: %s\n' "$DB_PATH" >&2
        return 1
    }
    [[ "$have" != *visits* ]] && alters+="ALTER TABLE entries ADD COLUMN visits INTEGER DEFAULT 1;"$'\n'
    [[ "$have" != *tick*   ]] && alters+="ALTER TABLE entries ADD COLUMN tick INTEGER DEFAULT 0;"$'\n'
    if [[ -n "$alters" ]]; then
        run_sql "$alters
UPDATE entries SET visits = 1 WHERE visits IS NULL;
UPDATE entries SET tick = 0 WHERE tick IS NULL;" >/dev/null 2>&1 || {
            printf 'frecency: database column migration failed: %s\n' "$DB_PATH" >&2
            return 1
        }
    fi

    # --- v2 -> v3: bookmarks are no longer pinned at a constant 9999 score ---
    # v2 lifted entries with a keyword to PIN_BASE, an artificial constant unrelated
    # to EMS. Scores must return to real history; otherwise removing the old
    # constant still leaves old bookmarks dominating for a long time.
    if [[ "$prev" == "2" ]]; then
        run_sql "UPDATE entries SET score = 1.0 WHERE keyword != '' AND score >= 1000;" >/dev/null 2>&1 || {
            printf 'frecency: bookmark score migration failed: %s\n' "$DB_PATH" >&2
            return 1
        }
    fi

    # --- Step 3: indexes (the tick column must already exist) ---
    run_sql "
CREATE INDEX IF NOT EXISTS idx_entries_frecency ON entries (score DESC, last_access DESC);
CREATE INDEX IF NOT EXISTS idx_entries_keyword ON entries (keyword) WHERE keyword != '';
CREATE INDEX IF NOT EXISTS idx_entries_tick ON entries (tick);
CREATE INDEX IF NOT EXISTS idx_deleted_at ON deleted_entries (deleted_at DESC);
UPDATE meta SET v = '$SCHEMA_VERSION' WHERE k = 'schema_version';
" >/dev/null 2>&1 || {
        printf 'frecency: failed to create indexes or update schema version: %s\n' "$DB_PATH" >&2
        return 1
    }
}

# Initialization/migration is serialized with flock. After waiting for the lock,
# re-check the marker so concurrent first runs do not migrate twice.
# The marker is written with an atomic rename only after migration and the exp()
# probe succeed.
_initialize() {
    local force="${1:-0}" lock_fd tmp_marker
    local mv=""
    [[ -s "$MARKER" ]] && read -r mv < "$MARKER"
    [[ "$force" != 1 && "$mv" == "$SCHEMA_VERSION" ]] && return 0
    if ! command -v flock >/dev/null 2>&1; then
        printf 'frecency: initialization requires flock (util-linux)\n' >&2
        return 1
    fi
    exec {lock_fd}>"${MARKER}.lock" || return 1
    flock -x "$lock_fd" || { exec {lock_fd}>&-; return 1; }

    mv=""
    [[ -s "$MARKER" ]] && read -r mv < "$MARKER"
    if [[ "$force" == 1 || "$mv" != "$SCHEMA_VERSION" ]]; then
        do_init || { exec {lock_fd}>&-; return 1; }
        _require_math_functions
        if [[ -f "$DB_PATH" ]]; then
            tmp_marker="${MARKER}.$$"
            if ! printf '%s\n' "$SCHEMA_VERSION" > "$tmp_marker" || ! mv -f -- "$tmp_marker" "$MARKER"; then
                rm -f -- "$tmp_marker"
                printf 'frecency: cannot write database ready marker: %s\n' "$MARKER" >&2
                exec {lock_fd}>&-
                return 1
            fi
        fi
    fi
    exec {lock_fd}>&-
}

_ensure_ready() {
    _initialize 0
}

# exp() requires SQLite >= 3.35 built with SQLITE_ENABLE_MATH_FUNCTIONS.
# This is a hard requirement with no approximate fallback: interpolation/step
# implementations are complex and any approximation creates ties at grade
# boundaries, breaking the total order of EMS (same problem as the old 0.05 floor).
# If missing, fail loudly and ask the user to upgrade; mainstream distributions
# ship sqlite3 >= 3.35 with math functions.
_require_math_functions() {
    [[ "$(run_sql "SELECT printf('%.4f', exp(1));" 2>/dev/null)" == "2.7183" ]] && return 0
    printf 'frecency: this sqlite3 (%s) lacks the exp() math function; EMS decay cannot be computed.\n' \
        "$("$SQLITE3" --version 2>/dev/null | awk '{print $1}')" >&2
    printf '  Upgrade to sqlite3 >= 3.35.0 (built with SQLITE_ENABLE_MATH_FUNCTIONS;\n' >&2
    printf '  mainstream distribution builds include it), or run frecency-test for a self-check.\n' >&2
    exit 1
}

# Current score: align stored from "the entry's own tick" to "the current tick".
# Write and read share the same expression:
#   write score = <expr> + 1   (meta.tick was already incremented; expr subtracts old tick)
#   read current = <expr>      (sorting / cleanup / display must use this, not stored)
_decay_expr() {
    local dt="((SELECT CAST(v AS INTEGER) FROM meta WHERE k = 'tick') - tick)"
    printf 'score * exp(-%s * %s)' "$LAMBDA" "$dt"
}

do_cleanup() {
    _ensure_ready || return 1
    run_sql "
DELETE FROM entries WHERE keyword = '' AND last_access < datetime('now', '-$MAX_DAYS days');
DELETE FROM entries
 WHERE keyword = ''
   AND content IN (SELECT content FROM entries
                    WHERE keyword = ''
                    ORDER BY $(_decay_expr) DESC, last_access DESC
                    LIMIT -1 OFFSET $MAX_ENTRIES);
DELETE FROM deleted_entries
 WHERE content NOT IN (SELECT content FROM deleted_entries
                        ORDER BY deleted_at DESC LIMIT $UNDO_KEEP);
" >/dev/null
}

# ============================================================================
# Write: event clock + exponential decay
# ============================================================================
_do_upsert() {
    local content="$1" keyword="$2"
    # The first insert does not go through ON CONFLICT; its initial score is one event.
    # keyword only participates in grading when the query hits it, and exempts the
    # entry from cleanup; it no longer inflates the EMS score.
    run_sql "
BEGIN IMMEDIATE;
UPDATE meta SET v = CAST(CAST(v AS INTEGER) + 1 AS TEXT) WHERE k = 'tick';
INSERT INTO entries (content, keyword, score, visits, tick, last_access)
VALUES ($(sql_lit "$content"), $(sql_lit "$keyword"), 1.0, 1,
        (SELECT CAST(v AS INTEGER) FROM meta WHERE k = 'tick'), CURRENT_TIMESTAMP)
ON CONFLICT(content) DO UPDATE SET
    keyword = CASE WHEN $(sql_lit "$keyword") != '' THEN $(sql_lit "$keyword") ELSE keyword END,
    -- No floor: decaying to 1e-100 just means the next +1 is nearly 1; a floor only
    -- creates ties.
    score = $(_decay_expr) + 1,
    visits = visits + 1,
    tick = (SELECT CAST(v AS INTEGER) FROM meta WHERE k = 'tick'),
    last_access = CURRENT_TIMESTAMP;
COMMIT;
" >/dev/null
}

do_add() {
    local content="$1" keyword="$2"

    for pattern in "${IGNORE_PATTERNS[@]}"; do
        [[ "$content" == $pattern ]] && return 0
    done

    _ensure_ready || return 1
    _do_upsert "$content" "$keyword" || return 1

    # Probabilistic background maintenance (0.1%)
    (( RANDOM % 1000 == 0 )) && $SELF "$TOPIC" cleanup >/dev/null 2>&1 &
}

# recent <seconds>: succeed if any entry was updated within the last N seconds.
# Used by the Neovim integration to skip a duplicate record right after vifm's
# own DirEnter/open hook has already written the same navigation.
do_recent() {
    local seconds="${1:-5}"
    [[ "$seconds" =~ ^[0-9]+$ ]] || {
        printf 'frecency: recent requires a whole number of seconds: %s\n' "$seconds" >&2
        return 2
    }
    _ensure_ready || return 1
    local hit
    hit=$(run_sql "SELECT 1 FROM entries
                   WHERE last_access >= datetime('now', '-$seconds seconds')
                   LIMIT 1;")
    [[ -n "$hit" ]]
}

# ============================================================================
# Preview
# ============================================================================
do_preview() {
    local content="${1##*$SEP}"     # last field = the real path/command
    local db_info

    # Full path: the list column is narrow and long paths get truncated; the first
    # preview line shows the whole path. FZF_PREVIEW_COLUMNS is injected by fzf and
    # fold wraps to the preview width (paths rarely contain spaces, so -s falls back
    # to a hard width cut).
    printf '%s%s%s\n' "${C_CYAN}${C_BOLD}" "--- Full Path ---" "$C_NORMAL"
    printf '%s\n' "$content" | fold -s -w "${FZF_PREVIEW_COLUMNS:-100}"
    printf '\n'

    _ensure_ready || return 1

    if [[ -f "$DB_PATH" ]]; then
        # Grade calculation: reproduce the ORDER BY CASE WHEN ladder with
        # FZF_QUERY (the current search term injected by fzf), so the preview grade
        # matches actual ordering. grade is NULL when GRADE_MODE != on or no query.
        local cur_expr=$(_decay_expr)
        local grade_col="NULL"
        local from_extra=""
        if [[ "${GRADE_MODE:-on}" == "on" && -n "${FZF_QUERY:-}" ]]; then
            local q="$FZF_QUERY"
            local -a preview_words=()
            read -r -a preview_words <<< "$q"
            local last_word="${preview_words[${#preview_words[@]}-1]}"
            from_extra=", REPLACE(content, RTRIM(content, REPLACE(content, '/', '')), '') AS last_seg"
            grade_col=$(_query_grade_expr "$q" "$last_word" "$(_current_multiword_mode)")
        fi

        db_info=$(run_sql "
            SELECT printf('%.4f', $cur_expr) || '$SEP' ||
                   COALESCE(NULLIF(keyword,''), 'None') || '$SEP' ||
                   strftime('%Y-%m-%d %H:%M:%S', last_access, 'localtime') ||
                   '$SEP' || IFNULL(CAST(grade AS TEXT), 'NULL')
            FROM (
                SELECT inner.*, $grade_col AS grade
                FROM (SELECT entries.* $from_extra FROM entries) AS inner
            )
            WHERE content = $(sql_lit "$content") LIMIT 1;")
    fi

    printf '%s%s%s\n' "${C_YELLOW}${C_BOLD}" "--- Metadata ---" "$C_NORMAL"
    if [[ -n "$db_info" ]]; then
        IFS="$SEP" read -r db_score db_key db_time db_grade <<< "$db_info"
        printf 'EMS Score: %s%s%s | Keyword: %s%s%s | Last Access: %s\n' \
            "$C_CYAN" "$db_score" "$C_NORMAL" "$C_GREEN" "${db_key:-None}" "$C_NORMAL" "$db_time"
        if [[ -n "${db_grade:-}" && "${db_grade}" != "NULL" ]]; then
            local grade_label
            case "$db_grade" in
                0)  grade_label="0 keyword == query (exact)" ;;
                1)  grade_label="1 keyword starts with query" ;;
                2)  grade_label="2 keyword contains query" ;;
                3)  grade_label="3 last_seg == query (exact)" ;;
                4)  grade_label="4 last_seg starts with query" ;;
                5)  grade_label="5 last_seg contains query" ;;
                6)  grade_label="6 middle segment starts with query" ;;
                7)  grade_label="7 generic substring match" ;;
                *)  grade_label="$db_grade" ;;
            esac
            printf 'Effective order: %s → EMS %s\n' "$grade_label" "$db_score"
        else
            printf 'Effective order: EMS %s  (no query grade)\n' "$db_score"
        fi
    else
        printf 'Status: %sNew / Unrecorded Item%s\n' "$C_YELLOW" "$C_NORMAL"
    fi
    printf '\n'

    _apply_highlight() {
        local target="$1"; local limit="$2"
        if command -v bat >/dev/null 2>&1; then
            bat --color=always --style=plain --line-range=:"$limit" "$target"
        elif command -v highlight >/dev/null 2>&1; then
            highlight -O ansi --force "$target" | head -n "$limit"
        else
            head -n "$limit" "$target"
        fi
    }

    if [[ -e "$content" ]]; then
        if [[ -d "$content" ]]; then
            printf '%s%s%s\n' "${C_BLUE}${C_BOLD}" "--- Directory Contents ---" "$C_NORMAL"
            command -v eza >/dev/null 2>&1 \
                && eza -a --color=always --icons --no-permissions --no-user --no-time --no-filesize "$content" | head -n 40 \
                || ls -la --color=always "$content" | head -n 40
        else
            local mime=$(file --mime-type -b "$content" 2>/dev/null)
            local desc=$(file -b "$content" 2>/dev/null)
            if [[ "$mime" == text/* || "$desc" == *"text"* || "$desc" == *"script"* ]]; then
                printf '%s%s%s\n' "${C_GREEN}${C_BOLD}" "--- Text Preview ---" "$C_NORMAL"
                _apply_highlight "$content" 100
            else
                printf '%s%s%s\n' "${C_BLUE}${C_BOLD}" "--- Binary File Info ---" "$C_NORMAL"
                file -b "$content"; ls -ldh "$content" | awk '{print "Size: "$5"\nPerms: "$1"\nOwner: "$3}'
            fi
        fi
    else
        local cmd_name="${content%% *}"
        local cmd_type=$(type -t "$cmd_name" 2>/dev/null)
        if [[ -n "$cmd_type" ]]; then
            printf '%s%s%s\n' "${C_GREEN}${C_BOLD}" "--- Command Info ---" "$C_NORMAL"
            printf 'Type: %s%s%s\n' "$C_CYAN" "$cmd_type" "$C_NORMAL"
            case "$cmd_type" in
                alias) alias "$cmd_name" 2>/dev/null || type "$cmd_name" ;;
                file)
                    local real_path=$(which "$cmd_name" 2>/dev/null)
                    printf 'Binary: %s%s%s\n----------------------\n' "$C_BLUE" "$real_path" "$C_NORMAL"
                    local r_desc=$(file -b "$real_path" 2>/dev/null)
                    if [[ "$r_desc" == *"text"* || "$r_desc" == *"script"* ]]; then
                        printf '%s%s%s\n' "$C_BOLD" "Script Snippet:" "$C_NORMAL"; _apply_highlight "$real_path" 30
                    else
                        file -b "$real_path"
                    fi ;;
                *) type "$cmd_name" | head -n 20 ;;
            esac
        else
            printf '%s%s%s\n%s\n' "${C_BLUE}${C_BOLD}" "--- Raw Entry ---" "$C_NORMAL" "$content"
        fi
    fi
}

# ============================================================================
# Query
# ============================================================================
_do_internal_query() {
    local mode="$1"; local term="$2"
    _ensure_ready || return 1
    # score_cur = score aligned to the current tick. A stored score is only valid
    # at its own tick; ORDER BY score would compare scores from different moments
    # and produce a meaningless order.
    local cur; cur=$(_decay_expr)
    local where="" sub_extra="" grade_expr="NULL"
    local order="ORDER BY score_cur DESC, last_access DESC"

    if [[ "$mode" == "last" ]]; then
        order="ORDER BY last_access DESC LIMIT $LAST_LIMIT"
    elif [[ "$SEARCH_MODE" == "sqlite" && -n "$term" ]]; then
        # Ordered mode combines words into %foo%bar%; any-order mode still matches
        # word by word. Both require the whole query to hit one field, never half
        # path and half keyword.
        local -a words=() conds=()
        read -r -a words <<< "$term"
        local multiword_mode; multiword_mode=$(_current_multiword_mode)
        if [[ "$multiword_mode" == "ordered" ]]; then
            local ordered_pattern; ordered_pattern=$(sql_like_ordered "$term")
            where="WHERE (content LIKE $ordered_pattern ESCAPE '!' OR keyword LIKE $ordered_pattern ESCAPE '!')"
        else
            where="WHERE ($(_all_words_like_expr content "${words[@]}") OR $(_all_words_like_expr keyword "${words[@]}"))"
        fi

        # ---- Match-quality grading (SEARCH_MODE=sqlite only; skipped when GRADE_MODE=off) ----
        # The real target is the last path segment (final file/directory name), so the
        # last segment uses the same three-level semantics as keyword:
        #   exact > prefix > contains
        # If the last segment misses, fall back to middle segments, then any substring.
        #
        # Grade ladder:
        #   0      keyword equals query
        #   1      keyword starts with query
        #   2      keyword contains query
        #   3      last segment equals query        (/a/b/proj)
        #   4      last segment starts with query   (/a/b/proj.conf)
        #   5      last segment contains query      (/a/b/myprojX)
        #   6      a middle path segment starts with query (/a/proj/c/foo)
        #   7      any other substring match
        #
        # Last segment extraction: SQLite has no REVERSE(), so use the RTRIM trick:
        #   REPLACE(content, '/', '') yields the character set without slashes,
        #   RTRIM(content, that set) strips the tail until a slash stops it,
        #   REPLACE(content, remaining prefix, '') extracts the last segment.
        if [[ "${GRADE_MODE:-on}" != "on" ]]; then
            # Grading off: order solely by real aligned EMS; keyword still filters WHERE.
            order="ORDER BY score_cur DESC, last_access DESC"
        else
        # With multiple words, the last word is best for last-segment grading.
        local last_word="${words[${#words[@]}-1]}"
        # Inject last_seg into the subquery; computed only with a query and grading on.
        sub_extra=", REPLACE(content, RTRIM(content, REPLACE(content, '/', '')), '') AS last_seg"
        grade_expr=$(_query_grade_expr "$term" "$last_word" "$multiword_mode")
        # A keyword hit uses keyword grades (0-2); a path-only hit uses path grades
        # (3-7). A non-empty keyword alone does not get extra priority.
        order="ORDER BY rank_grade ASC, score_cur DESC,
               LENGTH(content) ASC, last_access DESC"
        fi
    fi
    local select_sql="SELECT
            keyword,
            printf('%.4f', score_cur),
            CASE
                WHEN keyword = '' THEN printf('%-8.2f', score_cur)
                ELSE keyword || printf('%' || MAX(0, 8 - LENGTH(keyword)) || 's', '')
            END,
            content,
            $grade_expr AS rank_grade
        FROM (SELECT entries.*, $cur AS score_cur${sub_extra} FROM entries)"
    # Output a display column plus the raw path column. fzf shows column 1 and
    # accepts column 2; sqlite mode searches full paths in SQL, so fzf can disable
    # local filtering without losing matching ability.
    run_sql "$select_sql $where $order" | FRECENCY_QUERY="$([[ "$SEARCH_MODE" == "sqlite" ]] && printf '%s' "$term")" \
        awk -F "$SEP" -v OFS="$SEP" -v max_path_chars="$MAX_PATH_CHARS" '
    BEGIN {
        IGNORECASE = 1
        query = ENVIRON["FRECENCY_QUERY"]
        nwords = split(query, words, /[[:space:]]+/)
        for (wi = 1; wi <= nwords; wi++) {
            if (words[wi] == "") continue
            nchars = split(words[wi], chars, "")
            literal = ""
            for (ci = 1; ci <= nchars; ci++) {
                ch = chars[ci]
                if (index("\\.^$|?*+()[]{}", ch)) literal = literal "\\"
                literal = literal ch
            }
            match_re = match_re (match_re == "" ? "" : "|") literal
        }
        if (match_re != "") match_re = "(" match_re ")"
    }
    function highlight(value,    rest,out) {
        if (match_re == "") return value
        rest = value
        out = ""
        while (match(rest, match_re)) {
            out = out substr(rest, 1, RSTART - 1) "\033[30;103m" \
                  substr(rest, RSTART, RLENGTH) "\033[0m"
            rest = substr(rest, RSTART + RLENGTH)
        }
        return out rest
    }
    function path_chars(value,    chars,n,i,total) {
        n = split(value, chars, "")
        total = 0
        for (i = 1; i <= n; i++) total += (chars[i] ~ /^[\001-\177]$/ ? 1 : 2)
        return total
    }
    function shorten(path, max,    parts,n,i,last,suffix,marker,marker_width,part_width,available,chars,nchars,out,width) {
        n = split(path, parts, "/")
        marker = ".../"
        last = parts[n]
        suffix = last

        # If the last segment itself is too long, keep its rightmost characters;
        # the path width never exceeds the configured maximum.
        width = path_chars(suffix)
        if (width + path_chars(marker) > max) {
            available = max - path_chars("...")
            if (available < 1) return ""
            nchars = split(suffix, chars, "")
            out = ""
            width = 0
            for (i = nchars; i > 0; i--) {
                part_width = (chars[i] ~ /^[\001-\177]$/ ? 1 : 2)
                if (width + part_width > available) break
                out = chars[i] out
                width += part_width
            }
            return "..." out
        }

        # Consume whole directory segments from the right; never abbreviate the
        # file/directory name itself. Total width stays within max.
        marker_width = path_chars(marker)
        width = marker_width + path_chars(suffix)
        for (i = n - 1; i >= 1; i--) {
            if (parts[i] == "") continue
            part_width = path_chars(parts[i]) + 1
            if (width + part_width > max) break
            suffix = parts[i] "/" suffix
            width += part_width
        }
        return marker suffix
    }
    {
        full = $4
        prefix = $3
        if ($1 != "" && match_re == "") prefix = sprintf("\033[33m%s\033[0m", prefix)
        shown = (path_chars(full) > max_path_chars ? shorten(full, max_path_chars) : full)
        print highlight(prefix "  " shown), full
    }'
}

_do_internal_op() {
    local op="$1"
    local content="${2##*$SEP}"     # input is the whole row; take the last field
    # Any operation that modifies the stored score (add/del/undo) must go through
    # _ensure_ready: read the marker (one stat) to confirm the schema is ready;
    # if the host SQLite lacks exp(), fail here instead of silently degrading.
    _ensure_ready || return 1
    case "$op" in
        refresh)
            _do_upsert "$content" "" &
            ;;
        del)
            run_sql "
INSERT OR REPLACE INTO deleted_entries (content, keyword, score)
    SELECT content, keyword, score FROM entries WHERE content = $(sql_lit "$content");
DELETE FROM entries WHERE content = $(sql_lit "$content");" >/dev/null
            ;;
        unbook)
            run_sql "UPDATE entries SET keyword = '' WHERE content = $(sql_lit "$content");" >/dev/null
            ;;
        undo)
            run_sql "
INSERT OR IGNORE INTO entries (content, keyword, score, visits, tick, last_access)
    SELECT content, keyword, score, 1,
           (SELECT CAST(v AS INTEGER) FROM meta WHERE k='tick'), CURRENT_TIMESTAMP
    FROM deleted_entries ORDER BY deleted_at DESC LIMIT 1;
DELETE FROM deleted_entries WHERE content =
    (SELECT content FROM deleted_entries ORDER BY deleted_at DESC LIMIT 1);" >/dev/null
            ;;
    esac
}

do_unbook() {
    local content="$1" changed
    [[ -n "$content" ]] || { printf 'Usage: frecency <topic> unbook <content>\n' >&2; return 2; }
    _ensure_ready || return 1
    changed=$(run_sql "UPDATE entries SET keyword = '' WHERE content = $(sql_lit "$content") AND keyword != ''; SELECT changes();")
    if [[ "$changed" == "1" ]]; then
        printf 'Bookmark removed; EMS history retained: %s\n' "$content"
    else
        printf 'No bookmark found: %s\n' "$content"
    fi
}

# ============================================================================
# UI
# ============================================================================
do_query_ui() {
    _require_fzf
    local search_term="$1"

    local tmux_opt=""
    if [[ -n "$TMUX" ]]; then
        local _tmux_ver=$(tmux -V 2>/dev/null | grep -oE '[0-9]+\.[0-9]+' | head -1)
        if [[ -n "$_tmux_ver" ]] && awk "BEGIN{exit !($_tmux_ver >= 3.3)}" 2>/dev/null; then
            tmux_opt="--tmux 90%,80%"
        fi
    fi

    local P_NORMAL="${C_GREEN}${C_BOLD}● NORMAL${C_NORMAL}${C_BOLD} > "
    local P_SEARCH="${C_BLUE}${C_BOLD}● SEARCH${C_NORMAL}${C_BOLD} > "
    local FOOTER_HINTS="/Search  Esc Normal/Exit  d Del  r Unbook  u Undo  ↵ Accept"
    local FOOTER_STR="$FOOTER_HINTS"
    local SEARCH_ACTION=enable-search
    local -a FZF_VIEW_OPTS=(--with-nth=1)
    local INITIAL_DATA="$START_DATA" RELOAD_QUERY="all"
    local initial_multiword_mode="${MULTIWORD_MODE:-ordered}"
    [[ "$initial_multiword_mode" == "any-order" ]] || initial_multiword_mode="ordered"
    local _order_file="$(mktemp "${TMPDIR:-/tmp}/frecency_order.XXXXXX")"
    printf '%s\n' "$initial_multiword_mode" > "$_order_file"
    local -a initial_query_words=()
    read -r -a initial_query_words <<< "$search_term"
    if [[ "$SEARCH_MODE" == "sqlite" && ${#initial_query_words[@]} -ge 2 ]]; then
        [[ "$initial_multiword_mode" == "any-order" ]] \
            && FOOTER_STR="ANY ORDER · NORMAL s→ORDERED" \
            || FOOTER_STR="ORDERED · NORMAL s→ANY ORDER"
    fi
    if [[ "$SEARCH_MODE" == "sqlite" ]]; then
        # SQL reload filters full paths; fzf must not narrow the abbreviated display field.
        SEARCH_ACTION=disable-search
        FZF_VIEW_OPTS+=(--disabled)
        RELOAD_QUERY="all {q}"
        [[ -n "$search_term" ]] && INITIAL_DATA=all
    fi

    local CORE_KEYS=(q j k h l g G c C d r u x /)
    [[ "$SEARCH_MODE" == "sqlite" ]] && CORE_KEYS+=(s)
    local VIM_NAV=$(IFS=,; echo "${CORE_KEYS[*]}")

    local _mode_file=$(mktemp "${TMPDIR:-/tmp}/frecency_mode.XXXXXX")
    [[ "$START_MODE" == "normal" ]] && echo "normal" > "$_mode_file" || echo "search" > "$_mode_file"

    local _esc_handler="${_mode_file}.sh"
    local _order_toggle="${_mode_file}.toggle"
    local _footer_handler="${_mode_file}.footer"
    cat > "$_esc_handler" <<ESCSCRIPT
#!/bin/bash
if [ "\$(cat "$_mode_file")" = normal ]; then
    echo abort
else
    echo normal > "$_mode_file"
    echo "disable-search+rebind($VIM_NAV)+change-prompt($P_NORMAL)"
fi
ESCSCRIPT
    chmod +x "$_esc_handler"
    cat > "$_order_toggle" <<'ORDERSCRIPT'
#!/bin/bash
state_file="$1"
IFS= read -r mode < "$state_file" || mode=ordered
if [[ "$mode" == ordered ]]; then
    printf 'any-order\n' > "$state_file"
else
    printf 'ordered\n' > "$state_file"
fi
ORDERSCRIPT
    cat > "$_footer_handler" <<'FOOTER_SCRIPT'
#!/bin/bash
query="$1"
state_file="$2"
search_mode="$3"
IFS= read -r mode < "$state_file" || mode=ordered
read -r -a words <<< "$query"
if [[ "$search_mode" == sqlite && ${#words[@]} -ge 2 ]]; then
    if [[ "$mode" == any-order ]]; then
        printf '%s' 'change-footer(ANY ORDER · NORMAL s→ORDERED)'
    else
        printf '%s' 'change-footer(ORDERED · NORMAL s→ANY ORDER)'
    fi
else
    printf '%s' 'change-footer(/Search  Esc Normal/Exit  d Del  r Unbook  u Undo  ↵ Accept)'
fi
FOOTER_SCRIPT
    chmod +x "$_order_toggle" "$_footer_handler"
    trap "rm -f '$_mode_file' '$_esc_handler' '$_order_file' '$_order_toggle' '$_footer_handler'" RETURN

    local SET_SEARCH="execute-silent(echo search > '$_mode_file')"
    local SET_NORMAL="execute-silent(echo normal > '$_mode_file')"

    local START_BIND="start:$SEARCH_ACTION+unbind($VIM_NAV)+change-prompt($P_SEARCH)+$SET_SEARCH"
    [[ "$START_MODE" == "normal" ]] && START_BIND="start:disable-search+change-prompt($P_NORMAL)+$SET_NORMAL"

    local SEARCH_BIND="$SEARCH_ACTION+unbind($VIM_NAV)+change-prompt($P_SEARCH)+$SET_SEARCH"
    [[ "$START_DATA" == "last" ]] && SEARCH_BIND="$SEARCH_BIND+transform:test -z '{q}' && echo 'reload($SELF \"$TOPIC\" internal-query all)' || echo 'nop'"

    local CHANGE_BIND="first"
    [[ "$SEARCH_MODE" == "sqlite" ]] && CHANGE_BIND="reload(sleep $SLEEP_DELAY; $SELF \"$TOPIC\" internal-query all {q} || true)+$CHANGE_BIND"
    CHANGE_BIND+="+transform:$_footer_handler {q} '$_order_file' '$SEARCH_MODE'"

    local RELOAD_AND_FILTER="reload($SELF \"$TOPIC\" internal-query $RELOAD_QUERY)+$SEARCH_ACTION+$SET_SEARCH"

    local -a ORDER_MODE_BIND=()
    if [[ "$SEARCH_MODE" == "sqlite" ]]; then
        ORDER_MODE_BIND+=(--bind "s:execute-silent($_order_toggle '$_order_file')+reload($SELF \"$TOPIC\" internal-query all {q} || true)+transform:$_footer_handler {q} '$_order_file' '$SEARCH_MODE'")
    fi

    # Keep only one fzf invocation: the two TERM branches had identical flags/bind,
    # and duplicated maintenance already caused one missed change (accept-nth).
    # Highlighting happens at the internal-query source and goes straight into fzf.
    FRECENCY_ORDER_FILE="$_order_file" $SELF "$TOPIC" internal-query "$INITIAL_DATA" "$search_term" | \
        FRECENCY_ORDER_FILE="$_order_file" fzf \
            --ansi --query "$search_term" --footer "$FOOTER_STR" \
            --layout=reverse --tiebreak='index' --no-sort $tmux_opt \
            --preview-window=right:50% --border=rounded --inline-info \
            --delimiter="$SEP" --accept-nth='2' "${FZF_VIEW_OPTS[@]}" --literal --exact \
            --bind "$START_BIND" --bind "change:$CHANGE_BIND" --bind "/:$SEARCH_BIND" \
            --bind "c:clear-query+$SEARCH_ACTION+unbind($VIM_NAV)+change-prompt($P_SEARCH)+$SET_SEARCH" \
            --bind "x:$SEARCH_ACTION+clear-query+$SET_SEARCH" \
            --bind "esc:transform:$_esc_handler" \
            --bind "j:down,k:up,h:backward-char,l:forward-char,g:first,G:last,q:abort" \
            --bind "d:execute-silent($SELF \"$TOPIC\" internal-op del {})+$RELOAD_AND_FILTER" \
            --bind "r:execute-silent($SELF \"$TOPIC\" internal-op unbook {})+$RELOAD_AND_FILTER" \
            --bind "u:execute-silent($SELF \"$TOPIC\" internal-op undo)+$RELOAD_AND_FILTER" \
            --bind "C:execute-silent($SELF \"$TOPIC\" cleanup)+$RELOAD_AND_FILTER" \
            "${ORDER_MODE_BIND[@]}" \
            --preview "$SELF \"$TOPIC\" preview {}"
}

# ============================================================================
# Jump / output for the caller to execute
# ============================================================================
do_jump_handler() {
    local term="$1" res
    if [[ -n "$term" ]]; then
        # zoxide / ze semantics: with a query, skip fzf and take the best entry by
        # EMS + match grade (first internal-query row = highest grade, then highest
        # score_cur within that grade).
        res=$($SELF "$TOPIC" internal-query all "$term" | head -n 1)
    else
        res=$($SELF "$TOPIC" query) || exit 0
    fi
    [[ -z "$res" ]] && exit 0
    local raw_path="${res##*$SEP}"

    if [[ "$TOPIC" == "cmd" ]]; then printf '%s\n' "$raw_path"; exit 0; fi

    if [[ -d "$raw_path" ]]; then
        printf "cd '%s'\n" "$(shq "$raw_path")"
    elif [[ -f "$raw_path" ]]; then
        _do_internal_op "refresh" "$raw_path"
        if [[ "$ACTION" == *"vifm" ]]; then
            printf "goto '%s'\n" "$(shq "$raw_path")"
        else
            if [[ "$XDG_SESSION_TYPE" == "wayland" ]] && command -v wl-copy >/dev/null; then
                printf '%s' "$raw_path" | wl-copy
            elif command -v xclip >/dev/null; then
                printf '%s' "$raw_path" | xclip -selection clipboard
            fi
            printf "cd '%s'; printf '%%s\\n' '%s'\n" \
                "$(shq "$(dirname "$raw_path")")" "$(shq "Copied path: $raw_path")"
        fi
    else
        if [[ "$TOPIC" == "dir" || "$TOPIC" == "file" ]]; then
            printf '%sError:%s Path not on disk: %s\n' "$C_YELLOW" "$C_NORMAL" "$raw_path" >&2
            exit 1
        else
            printf '%s\n' "$raw_path"
        fi
    fi
}

# ============================================================================
# Main router (topics may be comma-separated to write multiple DBs at once)
# ============================================================================
_require_sqlite3

IFS=',' read -r -a TOPICS <<< "$TOPIC"

for _T in "${TOPICS[@]}"; do
    export DB_PATH="$DATA_DIR/${_T}.db"
    export CONFIG_PATH="$DATA_DIR/${_T}.config"
    export MARKER="$DATA_DIR/.${_T}.v3"

    # Per-topic configuration overrides
    [[ -f "$CONFIG_PATH" ]] && source "$CONFIG_PATH"

    case "$ACTION" in
        init)           _initialize 1 ;;
        cleanup)        do_cleanup ;;
        add)            do_add "$1" "$2" ;;
        unbook)         do_unbook "$1" ;;
        remove)         _do_internal_op del "$1" ;;
        recent)         do_recent "$1" ;;
        query)          do_query_ui "$1" ;;
        preview)        do_preview "$1" ;;
        jump-handler*)  do_jump_handler "$*" ;;
        internal-query) _do_internal_query "$1" "$2" ;;
        internal-op)    _do_internal_op "$1" "$2" ;;
        *)              printf 'Unknown action: %s\n' "$ACTION"; exit 1 ;;
    esac
done
