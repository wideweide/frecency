" ============================================================================
" frecency.vifm - thin Vifm plugin for frecency
" ============================================================================
" #frecency for vifm
"
" Vifm only auto-loads Lua plugins from plugins/ (init.lua); a Vifmscript file
" placed there is not loaded and reports [failed]. This file therefore lives at
" ~/.config/vifm/frecency.vifm and is loaded explicitly from vifmrc:
"
"     source ~/.config/vifm/frecency.vifm
"
" The executable scripts live in ~/.config/vifm/scripts/ and must be on PATH:
"     frecency     main script
"     bmark.sh     bookmark bridge (creates a Vifm bookmark as well)
"
" To disable, comment out the source line in vifmrc.
"
" o and O complement each other:
"   o  global history (file topic) - fzf jump ordered by EMS and match grade
"      (with a query it jumps directly to the best match; without one it opens fzf)
"   O  current directory tree - fzf --walker file browser with no history order,
"      executed by bash so Vifm's runtime shell (fish) syntax is not involved

" --- 1. Core commands (silent, asynchronous, never block the UI) ---

" trackPath: record the current directory in the shared `file` topic.
" With an argument it is stored as a keyword; otherwise as a normal entry.
" %d is the absolute directory path, %a is the optional keyword.
command! trackPath !frecency file add "%d" %a >/dev/null 2>&1 &

" trackFile: record a file in the `file` topic only. %a is the optional keyword.
command! trackFile
    \ ! [ ! -d "%d/%f" ] && frecency file add "%d/%f" %a >/dev/null 2>&1 &

" Remove the current path from the shared `file` topic
command! removeRecord
    \ !frecency file remove "%d/%f" >/dev/null 2>&1 &

" Enhanced bookmark: call the external script to update the DB and Vifm bookmarks
command! Bmark : execute '!bmark.sh %d/%f %a &'

" --- 2. Automatic hook (autocmd) ---
" Every directory change silently records the directory in `file`
autocmd DirEnter *,.* trackPath

" --- 3. File operation mappings ---
" <silent> hides the command in the status bar

" Open: record first, then run the original action
nnoremap <silent> l :trackFile<cr>l
nnoremap <silent> <cr> :trackFile<cr><cr>

" Delete: remove the entry first, then run the original delete
nnoremap <silent> dd :removeRecord<cr>dd

" Create a bookmark (keyword)
nnoremap M :Bmark<space>

" --- 4. Interactive jumping (o / O) ---

" o: jump to a directory or file from the history database
nnoremap <silent> o :set noquickview |
    \ let $JUMP_CMD = system('frecency file jump-handler-vifm') |
    \ if $JUMP_CMD != '' | execute $JUMP_CMD | endif <cr>

" O: run fzf with bash explicitly so Vifm's configured fish syntax is not involved
nnoremap <silent> O :set noquickview |
    \ let $FZF_ROOT = expand('%d') |
    \ let $FZF_SELECTED = system("bash -c 'unset FZF_DEFAULT_COMMAND; exec fzf --scheme=path --walker=file,hidden --walker-root=\"$FZF_ROOT\" </dev/tty 2>/dev/tty'") |
    \ if $FZF_SELECTED != '' | execute 'goto' fnameescape($FZF_SELECTED) | endif <cr>
